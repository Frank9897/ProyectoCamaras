<Window x:Class="CameraInspector.App.VivotekParametersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:responsive="clr-namespace:CameraInspector.App.Responsive"
        responsive:ResponsiveWindowBehavior.Enable="True"
        Title="Camera Inspector — Parámetros VIVOTEK"
        Width="900"
        Height="650"
        MinWidth="620"
        MinHeight="460"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="180" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="PARÁMETROS VIVOTEK"
                   FontSize="20"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />

        <WrapPanel Grid.Row="1" Margin="0,10,0,10">
            <TextBlock VerticalAlignment="Center"
                       Text="Grupo:"
                       Foreground="{StaticResource TextDimBrush}"
                       Margin="0,0,8,5" />
            <ComboBox Width="180"
                      MinHeight="34"
                      ItemsSource="{Binding Groups}"
                      SelectedItem="{Binding SelectedGroup, UpdateSourceTrigger=PropertyChanged}"
                      Margin="0,0,8,5" />
            <Button Content="CONSULTAR"
                    Command="{Binding LoadCommand}"
                    MinWidth="110"
                    MinHeight="34"
                    Padding="16,7"
                    Margin="0,0,0,5" />
        </WrapPanel>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1"
                CornerRadius="4">
            <DataGrid ItemsSource="{Binding Parameters}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="GRUPO" Binding="{Binding Group}" Width="150" />
                    <DataGridTextColumn Header="PARÁMETRO" Binding="{Binding Name}" Width="300" />
                    <DataGridTextColumn Header="VALOR" Binding="{Binding Value}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{StaticResource TextDimBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="650"
                       Margin="0,0,10,5"
                       DockPanel.Dock="Left" />
            <Button Content="CERRAR"
                    Command="{Binding CloseCommand}"
                    MinWidth="90"
                    MinHeight="34"
                    Padding="16,7"
                    HorizontalAlignment="Right"
                    Margin="0,0,0,5"
                    DockPanel.Dock="Right" />
        </DockPanel>
    </Grid>
</Window>
