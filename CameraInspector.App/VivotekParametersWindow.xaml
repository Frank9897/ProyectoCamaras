<Window x:Class="CameraInspector.App.VivotekParametersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Inspector — Parámetros VIVOTEK"
        Width="900"
        Height="650"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FondoPrincipalBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="PARÁMETROS VIVOTEK"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextoPrincipalBrush}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,12">
            <TextBlock VerticalAlignment="Center"
                       Text="Grupo:"
                       Foreground="{DynamicResource TextoSecundarioBrush}"
                       Margin="0,0,8,0" />
            <ComboBox Width="220"
                      ItemsSource="{Binding Groups}"
                      SelectedItem="{Binding SelectedGroup, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="CONSULTAR"
                    Command="{Binding LoadCommand}"
                    Margin="10,0,0,0"
                    Padding="16,6" />
        </StackPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Parameters}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Visible">
            <DataGrid.Columns>
                <DataGridTextColumn Header="GRUPO" Binding="{Binding Group}" Width="160" />
                <DataGridTextColumn Header="PARÁMETRO" Binding="{Binding Name}" Width="300" />
                <DataGridTextColumn Header="VALOR" Binding="{Binding Value}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{DynamicResource TextoSecundarioBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       DockPanel.Dock="Left" />
            <Button Content="CERRAR"
                    Command="{Binding CloseCommand}"
                    Padding="16,6"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right" />
        </DockPanel>
    </Grid>
</Window>
