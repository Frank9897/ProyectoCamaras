<Window x:Class="CameraInspector.App.VivotekPtzWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Inspector — PTZ VIVOTEK"
        Width="430"
        Height="470"
        MinWidth="380"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="PTZ VIVOTEK"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock Text="Control propietario CGI"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="64" />
                <RowDefinition Height="64" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="76" />
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0" Grid.Column="1" Content="▲" Command="{Binding UpCommand}" FontSize="22" />
            <Button Grid.Row="1" Grid.Column="0" Content="◀" Command="{Binding LeftCommand}" FontSize="22" />
            <Button Grid.Row="1" Grid.Column="1" Content="■" Command="{Binding StopCommand}" FontSize="20" />
            <Button Grid.Row="1" Grid.Column="2" Content="▶" Command="{Binding RightCommand}" FontSize="22" />
            <Button Grid.Row="2" Grid.Column="1" Content="▼" Command="{Binding DownCommand}" FontSize="22" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,12">
            <Button Width="120" Margin="4" Content="HOME" Command="{Binding HomeCommand}" />
            <Button Width="120" Margin="4" Content="STOP" Command="{Binding StopCommand}" />
        </StackPanel>

        <StackPanel Grid.Row="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Width="140" Margin="4" Content="ZOOM WIDE" Command="{Binding ZoomWideCommand}" />
                <Button Width="140" Margin="4" Content="ZOOM TELE" Command="{Binding ZoomTeleCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding StatusText}"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
            <Button Margin="0,14,0,0" Content="CERRAR" Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>
</Window>
