<Window x:Class="CameraInspector.App.VivotekPtzWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:responsive="clr-namespace:CameraInspector.App.Responsive"
        responsive:ResponsiveWindowBehavior.Enable="True"
        Title="Camera Inspector — PTZ VIVOTEK"
        Width="430"
        Height="470"
        MinWidth="330"
        MinHeight="360"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="PTZ VIVOTEK"
                           FontSize="20"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="Control propietario CGI"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource TextDimBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="1" HorizontalAlignment="Center" Margin="0,2,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="60" />
                    <RowDefinition Height="60" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="72" />
                </Grid.ColumnDefinitions>

                <Button Grid.Row="0" Grid.Column="1" Content="▲" Command="{Binding UpCommand}" FontSize="22" ToolTip="Subir" />
                <Button Grid.Row="1" Grid.Column="0" Content="◀" Command="{Binding LeftCommand}" FontSize="22" ToolTip="Izquierda" />
                <Button Grid.Row="1" Grid.Column="1" Content="■" Command="{Binding StopCommand}" FontSize="20" ToolTip="Detener" />
                <Button Grid.Row="1" Grid.Column="2" Content="▶" Command="{Binding RightCommand}" FontSize="22" ToolTip="Derecha" />
                <Button Grid.Row="2" Grid.Column="1" Content="▼" Command="{Binding DownCommand}" FontSize="22" ToolTip="Bajar" />
            </Grid>

            <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,2,0,10">
                <Button Width="116" MinHeight="34" Margin="4" Content="HOME" Command="{Binding HomeCommand}" />
                <Button Width="116" MinHeight="34" Margin="4" Content="STOP" Command="{Binding StopCommand}" />
            </WrapPanel>

            <StackPanel Grid.Row="3">
                <WrapPanel HorizontalAlignment="Center">
                    <Button Width="132" MinHeight="34" Margin="4" Content="ZOOM WIDE" Command="{Binding ZoomWideCommand}" />
                    <Button Width="132" MinHeight="34" Margin="4" Content="ZOOM TELE" Command="{Binding ZoomTeleCommand}" />
                </WrapPanel>
                <TextBlock Text="{Binding StatusText}"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextDimBrush}" />
                <Button Margin="0,12,0,0" MinHeight="34" Content="CERRAR" Command="{Binding CloseCommand}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
