<Window x:Class="CameraInspector.App.CredentialsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Credenciales del dispositivo" Height="200" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="18">
        <TextBlock Text="Usuario:" Margin="0,0,0,4"/>
        <TextBox x:Name="UsernameBox" Margin="0,0,0,12"/>
        <TextBlock Text="Contraseña:" Margin="0,0,0,4"/>
        <PasswordBox x:Name="PasswordBox" Margin="0,0,0,16"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="80" Margin="0,0,8,0" Click="OnCancel"/>
            <Button Content="Aceptar" Width="80" Style="{StaticResource PrimaryButton}" Click="OnAccept" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
