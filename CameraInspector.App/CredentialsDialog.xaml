<Window x:Class="CameraInspector.App.CredentialsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Credenciales del dispositivo"
        Width="460"
        Height="320"
        MinWidth="380"
        MinHeight="270"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="CREDENCIALES DEL DISPOSITIVO"
                           FontFamily="Consolas"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="Ingrese las credenciales que utilizará Camera Inspector para autenticar las operaciones sobre la cámara."
                           Margin="0,6,0,16"
                           Foreground="{StaticResource TextDimBrush}"
                           TextWrapping="Wrap"/>

                <TextBlock Text="USUARIO"
                           Margin="0,0,0,5"
                           Foreground="{StaticResource TextDimBrush}"
                           FontWeight="Bold"/>
                <TextBox x:Name="UsernameBox"
                         Margin="0,0,0,12"/>

                <TextBlock Text="CONTRASEÑA"
                           Margin="0,0,0,5"
                           Foreground="{StaticResource TextDimBrush}"
                           FontWeight="Bold"/>
                <PasswordBox x:Name="PasswordBox"
                             Margin="0,0,0,12"/>

                <Border Padding="10"
                        Margin="0,0,0,16"
                        Background="{StaticResource Panel2Brush}"
                        BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="1">
                    <CheckBox x:Name="SaveCredentialCheckBox"
                              Content="Guardar credenciales de forma segura en este equipo"
                              VerticalAlignment="Center"/>
                </Border>

                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="CANCELAR"
                            MinWidth="100"
                            Margin="0,0,8,0"
                            Click="OnCancel"/>
                    <Button Content="ACEPTAR"
                            MinWidth="100"
                            Style="{StaticResource PrimaryButton}"
                            Click="OnAccept"
                            IsDefault="True"/>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
