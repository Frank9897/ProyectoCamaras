<Window x:Class="CameraInspector.App.LocalCamerasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Inspector — Cámaras locales / USB"
        Width="1200"
        Height="780"
        MinWidth="900"
        MinHeight="560"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="CÁMARAS LOCALES / USB" FontFamily="Consolas" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Webcams UVC, capturadoras y cámaras virtuales expuestas por Windows" Margin="0,5,0,0" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton" Content="ACTUALIZAR" MinWidth="110" Height="34" Margin="0,0,8,0" Click="RefreshButton_Click" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="InfoButton" Content="INFORMACIÓN" MinWidth="115" Height="34" Click="InfoButton_Click" Style="{StaticResource SecondaryButton}"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="260"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="5" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="DISPOSITIVOS" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" Text="Un teléfono por USB solo aparecerá como cámara cuando Windows lo exponga como fuente de vídeo. MTP por sí solo no es captura de vídeo." Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" FontSize="10"/>
                    <ListBox x:Name="CameraList" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" SelectionChanged="CameraList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="9" Margin="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}"><Run Text="Origen: "/><Run Text="{Binding DiscoverySource}"/></TextBlock>
                                        <TextBlock Margin="0,2,0,0" Foreground="{StaticResource TextDimBrush}"><Run Text="Estado: "/><Run Text="{Binding Status}"/></TextBlock>
                                        <TextBlock Margin="0,2,0,0" Foreground="{StaticResource TextDimBrush}"><Run Text="Transporte: "/><Run Text="{Binding Transport}"/></TextBlock>
                                        <TextBlock Margin="0,2,0,0" Foreground="{StaticResource TextDimBrush}"><Run Text="VID/PID: "/><Run Text="{Binding UsbVendorId}"/><Run Text=" / "/><Run Text="{Binding UsbProductId}"/></TextBlock>
                                        <TextBlock Margin="0,2,0,0" Foreground="{StaticResource TextDimBrush}"><Run Text="Índice captura: "/><Run Text="{Binding CaptureIndex}"/></TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="#000000" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="10,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="PREVISUALIZACIÓN LOCAL" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock x:Name="SelectedCameraNameText" Margin="0,4,0,0" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="CaptureStateTextBlock" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" FontFamily="Consolas" TextWrapping="Wrap"/>
                    </Grid>
                    <Border Grid.Row="1" Margin="10,0" Background="#000000" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                        <Grid>
                            <Image x:Name="VideoImage" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RenderOptions.BitmapScalingMode="LowQuality"/>
                            <TextBlock x:Name="NoVideoTextBlock" Text="SIN SEÑAL" FontFamily="Consolas" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="2" Margin="10,10,10,8">
                        <WrapPanel Margin="0,0,0,8">
                            <Button x:Name="SnapshotButton" Content="SNAPSHOT" MinWidth="105" Height="32" Margin="0,0,6,5" Click="SnapshotButton_Click" Style="{StaticResource SecondaryButton}"/>
                            <Button x:Name="RecordButton" Content="● GRABAR" MinWidth="105" Height="32" Margin="0,0,6,5" Click="RecordButton_Click" Style="{StaticResource SecondaryButton}"/>
                            <Button x:Name="StopRecordButton" Content="■ FIN GRABACIÓN" MinWidth="135" Height="32" Margin="0,0,6,5" Click="StopRecordButton_Click" Style="{StaticResource SecondaryButton}"/>
                            <Button x:Name="StopButton" Content="DETENER PREVIEW" MinWidth="125" Height="32" Margin="0,0,6,5" Click="StopButton_Click" Style="{StaticResource SecondaryButton}"/>
                        </WrapPanel>
                        <Border Padding="8" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                            <TextBlock x:Name="StatusTextBlock" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Margin="4,8,4,0" Text="Camera Inspector · Captura local UVC · Media Foundation / DirectShow" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
    </Grid>
</Window>
