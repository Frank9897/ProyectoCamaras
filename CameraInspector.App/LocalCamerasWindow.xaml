<Window x:Class="CameraInspector.App.LocalCamerasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Camera Inspector — Cámaras locales / USB"
        Width="1050"
        Height="680"
        MinWidth="900"
        MinHeight="560"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="CÁMARAS LOCALES / USB"
                               FontFamily="Consolas"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Dispositivos de vídeo que Windows expone localmente"
                               Margin="0,5,0,0"
                               Foreground="{StaticResource TextDimBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom"
                           Margin="0,10,0,0"
                           Text="Solo se muestran fuentes de captura de vídeo. Un teléfono conectado por USB no aparecerá aquí hasta que Windows lo exponga como cámara."
                           Foreground="{StaticResource TextDimBrush}"
                           TextWrapping="Wrap"
                           FontSize="10"/>

                <ListBox x:Name="CameraList"
                         ItemsSource="{Binding Cameras}"
                         SelectedItem="{Binding SelectedCamera, Mode=TwoWay}"
                         Background="{StaticResource Panel2Brush}"
                         BorderBrush="{StaticResource BorderBrush2}"
                         BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8" Margin="3"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BorderBrush2}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               FontFamily="Consolas"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Status}"
                                               Margin="0,4,0,0"
                                               Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Column="2"
                Background="#050a07"
                BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1"
                CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="PREVISUALIZACIÓN LOCAL"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{Binding SelectedCamera.Name}"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="DETENER"
                            Width="90"
                            Height="30"
                            Command="{Binding StopCommand}"
                            Style="{StaticResource SecondaryButton}"/>
                </Grid>

                <vlc:VideoView x:Name="VideoSurface"
                               Grid.Row="1"
                               Background="#000000"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"/>

                <Border Grid.Row="2"
                        Margin="10,8"
                        Padding="8"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="1">
                    <TextBlock Text="{Binding StatusText}"
                               FontFamily="Consolas"
                               FontSize="11"
                               Foreground="{StaticResource TextDimBrush}"
                               TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
