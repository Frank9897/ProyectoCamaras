<Window x:Class="CameraInspector.App.LocalCamerasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Camera Inspector — Cámaras locales / USB"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="620"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="CÁMARAS LOCALES / USB"
                               FontFamily="Consolas"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Webcams UVC, capturadoras y cámaras virtuales expuestas por Windows"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource TextDimBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="RefreshButton"
                            Content="ACTUALIZAR"
                            Width="105"
                            Height="32"
                            Margin="6,0,0,0"
                            Click="RefreshButton_Click"
                            Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="InfoButton"
                            Content="INFORMACIÓN"
                            Width="115"
                            Height="32"
                            Margin="6,0,0,0"
                            Click="InfoButton_Click"
                            Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="365"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom"
                               Margin="0,10,0,0"
                               Text="Un teléfono por USB solo aparecerá como cámara cuando Windows lo exponga como fuente de vídeo. MTP por sí solo no es captura de vídeo."
                               Foreground="{StaticResource TextDimBrush}"
                               TextWrapping="Wrap"
                               FontSize="10"/>

                    <ListBox x:Name="CameraList"
                             Background="{StaticResource Panel2Brush}"
                             BorderBrush="{StaticResource BorderBrush2}"
                             BorderThickness="1"
                             SelectionChanged="CameraList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="3"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderBrush2}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontFamily="Consolas"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Margin="0,4,0,0"
                                                   Foreground="{StaticResource AccentBrush}">
                                            <Run Text="Origen: "/><Run Text="{Binding DiscoverySource}"/>
                                        </TextBlock>
                                        <TextBlock Margin="0,2,0,0"
                                                   Foreground="{StaticResource TextDimBrush}">
                                            <Run Text="Estado: "/><Run Text="{Binding Status}"/>
                                        </TextBlock>
                                        <TextBlock Margin="0,2,0,0"
                                                   Foreground="{StaticResource TextDimBrush}">
                                            <Run Text="Transporte: "/><Run Text="{Binding Transport}"/>
                                        </TextBlock>
                                        <TextBlock Margin="0,2,0,0"
                                                   Foreground="{StaticResource TextDimBrush}">
                                            <Run Text="VID/PID: "/><Run Text="{Binding UsbVendorId}"/><Run Text=" / "/><Run Text="{Binding UsbProductId}"/>
                                        </TextBlock>
                                        <TextBlock Margin="0,2,0,0"
                                                   Foreground="{StaticResource TextDimBrush}">
                                            <Run Text="Previsualización: "/><Run Text="{Binding PreviewSupported}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="#000000"
                    BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1"
                    CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="PREVISUALIZACIÓN LOCAL"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock x:Name="SelectedCameraNameText"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource TextBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="SnapshotButton"
                                    Content="SNAPSHOT"
                                    Width="95"
                                    Height="30"
                                    Margin="6,0,0,0"
                                    Click="SnapshotButton_Click"
                                    Style="{StaticResource SecondaryButton}"/>
                            <Button x:Name="RecordButton"
                                    Content="● GRABAR"
                                    Width="95"
                                    Height="30"
                                    Margin="6,0,0,0"
                                    Click="RecordButton_Click"
                                    Style="{StaticResource SecondaryButton}"/>
                            <Button x:Name="StopRecordButton"
                                    Content="■ FIN GRABACIÓN"
                                    Width="125"
                                    Height="30"
                                    Margin="6,0,0,0"
                                    Click="StopRecordButton_Click"
                                    Style="{StaticResource SecondaryButton}"/>
                            <Button x:Name="StopButton"
                                    Content="DETENER PREVIEW"
                                    Width="125"
                                    Height="30"
                                    Margin="6,0,0,0"
                                    Click="StopButton_Click"
                                    Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>
                    </Grid>

                    <vlc:VideoView x:Name="VideoSurface"
                                   Grid.Row="1"
                                   Background="#000000"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"/>

                    <Border Grid.Row="2"
                            Margin="10,8"
                            Padding="8"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush2}"
                            BorderThickness="1">
                        <TextBlock x:Name="StatusTextBlock"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
