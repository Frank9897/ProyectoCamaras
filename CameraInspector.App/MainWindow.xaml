<Window x:Class="CameraInspector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Camera Inspector" Height="1280" Width="1450"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="280"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="320"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado principal de la aplicación. -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="CAMERA INSPECTOR" FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                <TextBlock Text=" — Descubrimiento y diagnóstico de dispositivos" FontSize="13"
                           Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <ComboBox ItemsSource="{Binding AvailableInterfaces}"
                          SelectedItem="{Binding SelectedInterface}"
                          Width="290" Margin="0,0,10,0"/>
                <Button Content="▣ Escanear red" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ScanCommand}"/>
            </StackPanel>
        </DockPanel>

        <!-- Estado operativo visible para el técnico. -->
        <TextBlock Grid.Row="1" Text="{Binding StatusText}" Foreground="{StaticResource TextDimBrush}"
                   FontFamily="Consolas" FontSize="12" Margin="0,0,0,10"/>

        <!-- Tabla principal de dispositivos encontrados. -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6">
            <DataGrid ItemsSource="{Binding Devices}" BorderThickness="0" IsReadOnly="True"
                      SelectedItem="{Binding SelectedDevice}"
                      AutoGenerateColumns="False"
                      CanUserResizeRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ESTADO" Binding="{Binding Status}" Width="90"/>
                    <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="125"/>
                    <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="160"/>
                    <DataGridTextColumn Header="FABRICANTE" Binding="{Binding Manufacturer}" Width="130"/>
                    <DataGridTextColumn Header="MODELO" Binding="{Binding Model}" Width="155"/>
                    <DataGridTextColumn Header="FIRMWARE" Binding="{Binding Firmware}" Width="110"/>
                    <DataGridTextColumn Header="ONVIF" Binding="{Binding OnvifSupported}" Width="75"/>
                    <DataGridTextColumn Header="WS-DISCOVERY" Binding="{Binding DiscoveredByOnvif}" Width="105"/>
                    <DataGridTextColumn Header="RTSP" Binding="{Binding RtspSupported}" Width="70"/>
                    <DataGridTextColumn Header="DEVICE SERVICE" Binding="{Binding OnvifDeviceServiceXAddr}" Width="280"/>
                    <DataGridTextColumn Header="ÚLT. VISTO" Binding="{Binding LastSeenAt}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Panel técnico del dispositivo seleccionado. -->
        <Border Grid.Row="3" Margin="0,10,0,0"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6"
                Padding="14">
            <Grid DataContext="{Binding SelectedDevice}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="DETALLE DEL DISPOSITIVO" FontFamily="Consolas" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="🧪 Diagnóstico"
                                Command="{Binding DataContext.RunDiagnosticsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Margin="0,0,8,0"/>
                        <TextBlock Text="Capacidades detectadas automáticamente"
                                   Foreground="{StaticResource TextDimBrush}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <!-- Identidad principal. -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" Text="IP" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding IpAddress}" FontFamily="Consolas"/>
                    <TextBlock Grid.Column="2" Text="MAC" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                    <TextBlock Grid.Column="3" Text="{Binding MacAddress}" FontFamily="Consolas"/>
                    <TextBlock Grid.Column="4" Text="ESTADO" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                    <TextBlock Grid.Column="5" Text="{Binding Status}" FontFamily="Consolas" FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="FABRICANTE" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Manufacturer}" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="MODELO" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Model}" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="4" Text="SERIAL" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="5" Text="{Binding SerialNumber}" FontFamily="Consolas" Margin="0,8,0,0"/>
                </Grid>

                <!-- Capacidades ONVIF. -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,22,0"><TextBlock Text="ONVIF: " FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/><TextBlock Text="{Binding OnvifSupported}" FontFamily="Consolas"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,22,0"><TextBlock Text="MEDIA: " FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/><TextBlock Text="{Binding HasMediaService}" FontFamily="Consolas"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,22,0"><TextBlock Text="IMAGING: " FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/><TextBlock Text="{Binding HasImagingService}" FontFamily="Consolas"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,22,0"><TextBlock Text="PTZ: " FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/><TextBlock Text="{Binding HasPtzService}" FontFamily="Consolas"/></StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="EVENTS: " FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/><TextBlock Text="{Binding HasEventsService}" FontFamily="Consolas"/></StackPanel>
                </StackPanel>

                <!-- XAddrs reales publicados por la cámara. -->
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="DEVICE SERVICE" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OnvifDeviceServiceXAddr}" FontFamily="Consolas" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="MEDIA SERVICE" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OnvifMediaServiceXAddr}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="PTZ / EVENTS" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OnvifPtzServiceXAddr}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Visor RTSP. El VideoView se conecta al MediaPlayer del servicio singleton en MainWindow.xaml.cs. -->
        <Border Grid.Row="4" Margin="0,10,0,0" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6">
            <Grid Background="Black">
                <vlc:VideoView x:Name="VideoSurface" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                    <Button Content="■ Detener video"
                            Command="{Binding StopVideoCommand}"
                            Margin="0,0,8,0"/>
                    <StackPanel Orientation="Horizontal" Background="#AA000000" Padding="8,4">
                        <TextBlock Text="MAIN: " Foreground="White" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ResolvedMainStream.Resolution}" Foreground="White"/>
                        <TextBlock Text="   SUB: " Foreground="White" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ResolvedSubStream.Resolution}" Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Panel de diagnóstico. -->
        <Border Grid.Row="5" Margin="0,10,0,0"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="130"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="RESULTADOS DEL DIAGNÓSTICO" FontFamily="Consolas" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding DiagnosticResults}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserResizeRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PRUEBA" Binding="{Binding TestName}" Width="130"/>
                        <DataGridTextColumn Header="OK" Binding="{Binding Success}" Width="65"/>
                        <DataGridTextColumn Header="NO SOPORTADO" Binding="{Binding NotSupported}" Width="110"/>
                        <DataGridTextColumn Header="DURACIÓN" Binding="{Binding Duration}" Width="100"/>
                        <DataGridTextColumn Header="MENSAJE" Binding="{Binding Message}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Barra inferior con estadísticas del escaneo. -->
        <DockPanel Grid.Row="6" Margin="0,10,0,0">
            <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextDimBrush}">
                <Run Text="Total: "/><Run Text="{Binding Devices.Count, Mode=OneWay}"/>
                <Run Text=" dispositivos · Ping/ARP + WS-Discovery + ONVIF + RTSP + diagnóstico"/>
            </TextBlock>
        </DockPanel>
    </Grid>
</Window>
