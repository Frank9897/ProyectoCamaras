<Window x:Class="CameraInspector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Inspector" Height="900" Width="1380"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado principal de la aplicación. -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="CAMERA INSPECTOR" FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                <TextBlock Text=" — Descubrimiento y diagnóstico de dispositivos" FontSize="13"
                           Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <ComboBox ItemsSource="{Binding AvailableInterfaces}"
                          SelectedItem="{Binding SelectedInterface}"
                          Width="290" Margin="0,0,10,0"/>
                <Button Content="▣ Escanear red" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ScanCommand}"/>
            </StackPanel>
        </DockPanel>

        <!-- Estado operativo visible para el técnico. -->
        <TextBlock Grid.Row="1" Text="{Binding StatusText}" Foreground="{StaticResource TextDimBrush}"
                   FontFamily="Consolas" FontSize="12" Margin="0,0,0,10"/>

        <!-- Tabla principal de dispositivos encontrados. -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6">
            <DataGrid ItemsSource="{Binding Devices}" BorderThickness="0" IsReadOnly="True"
                      SelectedItem="{Binding SelectedDevice}"
                      AutoGenerateColumns="False"
                      CanUserResizeRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ESTADO" Binding="{Binding Status}" Width="90"/>
                    <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="125"/>
                    <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="160"/>
                    <DataGridTextColumn Header="FABRICANTE" Binding="{Binding Manufacturer}" Width="130"/>
                    <DataGridTextColumn Header="MODELO" Binding="{Binding Model}" Width="155"/>
                    <DataGridTextColumn Header="FIRMWARE" Binding="{Binding Firmware}" Width="110"/>
                    <DataGridTextColumn Header="ONVIF" Binding="{Binding OnvifSupported}" Width="75"/>
                    <DataGridTextColumn Header="WS-DISCOVERY" Binding="{Binding DiscoveredByOnvif}" Width="105"/>
                    <DataGridTextColumn Header="RTSP" Binding="{Binding RtspSupported}" Width="70"/>
                    <DataGridTextColumn Header="DEVICE SERVICE" Binding="{Binding OnvifDeviceServiceXAddr}" Width="280"/>
                    <DataGridTextColumn Header="ÚLT. VISTO" Binding="{Binding LastSeenAt}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Panel de detalle. Aparece siempre, pero permanece informativo cuando no hay selección. -->
        <Border Grid.Row="3" Margin="0,10,0,0"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6"
                Padding="14">
            <Grid DataContext="{Binding SelectedDevice}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="IP" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding IpAddress}" FontFamily="Consolas"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="MAC" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding MacAddress}" FontFamily="Consolas"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="FABRICANTE" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                <TextBlock Grid.Row="0" Grid.Column="5" Text="{Binding Manufacturer}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="MODELO" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Model}" Margin="0,8,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="FIRMWARE" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Firmware}" Margin="0,8,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="4" Text="ONVIF" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="5" Text="{Binding OnvifSupported}" Margin="0,8,0,0"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="DEVICE SERVICE" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5" Text="{Binding OnvifDeviceServiceXAddr}"
                           FontFamily="Consolas" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </Grid>
        </Border>

        <!-- Barra inferior con acciones sobre la cámara seleccionada y estadísticas del escaneo. -->
        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="▶ Obtener URL de stream (Capa 5)"
                        Command="{Binding GetStreamUriCommand}" Margin="10,0,0,0"/>
            </StackPanel>

            <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextDimBrush}">
                <Run Text="Total: "/><Run Text="{Binding Devices.Count, Mode=OneWay}"/>
                <Run Text=" dispositivos · Ping/ARP + WS-Discovery + resolución de fabricante"/>
            </TextBlock>
        </DockPanel>
    </Grid>
</Window>
