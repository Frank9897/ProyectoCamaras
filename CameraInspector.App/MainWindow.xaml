<Window x:Class="CameraInspector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Inspector"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="600"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*" MinHeight="170"/>
            <RowDefinition Height="3*" MinHeight="200"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <Run Text="CAMERA INSPECTOR" FontFamily="Consolas" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                <Run Text="  //  DESCUBRIMIENTO · DIAGNÓSTICO · VIDEO · INVENTARIO" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
            </TextBlock>
        </Grid>

        <Border Grid.Row="1" Padding="9,7" Margin="0,0,0,8" BorderThickness="1" CornerRadius="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}">
            <TextBlock Text="{Binding StatusText}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="5" MinHeight="170">
            <DataGrid ItemsSource="{Binding Devices}"
                      SelectedItem="{Binding SelectedDevice}"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="True"
                      RowHeight="27"
                      ColumnHeaderHeight="29"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ESTADO" Binding="{Binding Status}" Width="80"/>
                    <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="115"/>
                    <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="140"/>
                    <DataGridTextColumn Header="FABRICANTE" Binding="{Binding Manufacturer}" Width="120"/>
                    <DataGridTextColumn Header="MODELO" Binding="{Binding Model}" Width="135"/>
                    <DataGridTextColumn Header="FIRMWARE" Binding="{Binding Firmware}" Width="95"/>
                    <DataGridTextColumn Header="EVIDENCIA" Binding="{Binding DetectionReason}" Width="220"/>
                    <DataGridTextColumn Header="ONVIF" Binding="{Binding OnvifSupported}" Width="60"/>
                    <DataGridTextColumn Header="WS-DISCOVERY" Binding="{Binding DiscoveredByOnvif}" Width="105"/>
                    <DataGridTextColumn Header="RTSP" Binding="{Binding RtspSupported}" Width="55"/>
                    <DataGridTextColumn Header="CAMERA ID" Binding="{Binding CameraId}" Width="80"/>
                    <DataGridTextColumn Header="ÚLT. VISTO" Binding="{Binding LastSeenAt}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Margin="0,8,0,0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="5" MinHeight="200">
            <Grid DataContext="{Binding SelectedDevice}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="160"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="11,8,11,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                        <Run Text="DETALLE DE CÁMARA" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        <Run Text="  //  " Foreground="{StaticResource TextDimBrush}"/>
                        <Run Text="{Binding Manufacturer}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding IpAddress}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                </Grid>

                <TabControl x:Name="DeviceDetailTabs" Grid.Row="1" Margin="7,0,7,7" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}">
                    <TabItem Header="GENERAL">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12">
                                <WrapPanel>
                                    <Border Padding="8,4" Margin="0,0,8,8" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"><StackPanel><TextBlock Text="IP" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/><TextBlock Text="{Binding IpAddress}" FontFamily="Consolas" TextWrapping="Wrap"/></StackPanel></Border>
                                    <Border Padding="8,4" Margin="0,0,8,8" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"><StackPanel><TextBlock Text="MAC" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/><TextBlock Text="{Binding MacAddress}" FontFamily="Consolas" TextWrapping="Wrap"/></StackPanel></Border>
                                    <Border Padding="8,4" Margin="0,0,8,8" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"><StackPanel><TextBlock Text="ESTADO" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/><TextBlock Text="{Binding Status}" FontFamily="Consolas" TextWrapping="Wrap"/></StackPanel></Border>
                                    <Border Padding="8,4" Margin="0,0,8,8" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"><StackPanel><TextBlock Text="FABRICANTE" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/><TextBlock Text="{Binding Manufacturer}" TextWrapping="Wrap"/></StackPanel></Border>
                                    <Border Padding="8,4" Margin="0,0,8,8" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"><StackPanel><TextBlock Text="MODELO" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/><TextBlock Text="{Binding Model}" TextWrapping="Wrap"/></StackPanel></Border>
                                    <Border Padding="8,4" Margin="0,0,8,8" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"><StackPanel><TextBlock Text="SERIAL" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/><TextBlock Text="{Binding SerialNumber}" FontFamily="Consolas" TextWrapping="Wrap"/></StackPanel></Border>
                                    <Border Padding="8,4" Margin="0,0,8,8" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"><StackPanel><TextBlock Text="CAMERA ID" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/><TextBlock Text="{Binding CameraId}" FontFamily="Consolas" TextWrapping="Wrap"/></StackPanel></Border>
                                    <Border Padding="8,4" Margin="0,0,8,8" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"><StackPanel><TextBlock Text="FIRMWARE" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/><TextBlock Text="{Binding Firmware}" TextWrapping="Wrap"/></StackPanel></Border>
                                    <Border Padding="8,4" Margin="0,0,8,8" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"><StackPanel><TextBlock Text="ÚLT. VISTO" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/><TextBlock Text="{Binding LastSeenAt}" FontFamily="Consolas" TextWrapping="Wrap"/></StackPanel></Border>
                                </WrapPanel>
                                <TextBlock Text="MÉTODOS DE DETECCIÓN" Margin="0,6,0,7" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontWeight="Bold"/>
                                <Border Padding="9" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"><TextBlock Text="{Binding DetectionDetails}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/></Border>
                                <TextBlock Text="CAPACIDADES ONVIF" Margin="0,14,0,7" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontWeight="Bold"/>
                                <WrapPanel>
                                    <Border Padding="8,4" Margin="0,0,6,6" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Background="{StaticResource Panel2Brush}"><TextBlock><Run Text="ONVIF  "/><Run Text="{Binding OnvifSupported}" FontFamily="Consolas"/></TextBlock></Border>
                                    <Border Padding="8,4" Margin="0,0,6,6" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Background="{StaticResource Panel2Brush}"><TextBlock><Run Text="MEDIA  "/><Run Text="{Binding HasMediaService}" FontFamily="Consolas"/></TextBlock></Border>
                                    <Border Padding="8,4" Margin="0,0,6,6" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Background="{StaticResource Panel2Brush}"><TextBlock><Run Text="IMAGING  "/><Run Text="{Binding HasImagingService}" FontFamily="Consolas"/></TextBlock></Border>
                                    <Border Padding="8,4" Margin="0,0,6,6" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Background="{StaticResource Panel2Brush}"><TextBlock><Run Text="PTZ  "/><Run Text="{Binding HasPtzService}" FontFamily="Consolas"/></TextBlock></Border>
                                    <Border Padding="8,4" Margin="0,0,6,6" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Background="{StaticResource Panel2Brush}"><TextBlock><Run Text="EVENTS  "/><Run Text="{Binding HasEventsService}" FontFamily="Consolas"/></TextBlock></Border>
                                    <Border Padding="8,4" Margin="0,0,6,6" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Background="{StaticResource Panel2Brush}"><TextBlock><Run Text="RTSP  "/><Run Text="{Binding RtspSupported}" FontFamily="Consolas"/></TextBlock></Border>
                                </WrapPanel>
                                <TextBlock Text="ENDPOINTS ONVIF" Margin="0,12,0,7" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontWeight="Bold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="DEVICE SERVICE" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OnvifDeviceServiceXAddr}" FontFamily="Consolas" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="MEDIA SERVICE" Margin="0,5,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OnvifMediaServiceXAddr}" Margin="0,5,0,0" FontFamily="Consolas" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="IMAGING SERVICE" Margin="0,5,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OnvifImagingServiceXAddr}" Margin="0,5,0,0" FontFamily="Consolas" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="PTZ SERVICE" Margin="0,5,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OnvifPtzServiceXAddr}" Margin="0,5,0,0" FontFamily="Consolas" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="EVENTS SERVICE" Margin="0,5,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding OnvifEventsServiceXAddr}" Margin="0,5,0,0" FontFamily="Consolas" TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="CREDENCIALES">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12">
                                <TextBlock Text="SEGURIDAD DEL DISPOSITIVO" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Text="La contraseña se almacena únicamente en Windows Credential Manager. SQLite conserva solo el usuario y la referencia al secreto."/>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="CREDENCIALES" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HasSavedCredentials}" FontFamily="Consolas" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="USUARIO" Margin="0,6,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SavedCredentialUsername}" Margin="0,6,0,0" FontFamily="Consolas" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="ÚLT. VERIFICACIÓN" Margin="0,6,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SavedCredentialLastVerifiedAt}" Margin="0,6,0,0" FontFamily="Consolas" TextWrapping="Wrap"/>
                                </Grid>
                                <CheckBox Content="Usar credenciales guardadas automáticamente" IsChecked="{Binding UseSavedCredentials}" Margin="0,14,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="IpVideoTab" Header="VIDEO">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="10">
                                <Border Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderAccentBrush}" BorderThickness="1" CornerRadius="5" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="VIDEO IP" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Margin="0,6,0,0" Text="La reproducción se abre en una ventana especializada. Esta pestaña no reserva un área fija que pueda desplazar el detalle." Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <WrapPanel Margin="0,0,0,8">
                <Button Content="ACTUALIZAR" Command="{Binding RefreshCommand}" MinWidth="105" Height="34" Margin="0,0,6,0" Style="{StaticResource PrimaryButton}"/>
            </WrapPanel>
            <Border Padding="9" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                <TextBlock Text="{Binding StatusText}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>