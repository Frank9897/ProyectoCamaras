<Window x:Class="CameraInspector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Inspector" Height="940" Width="1450"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="320"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado principal de la aplicación. -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="CAMERA INSPECTOR" FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                <TextBlock Text=" — Descubrimiento y diagnóstico de dispositivos" FontSize="13"
                           Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <ComboBox ItemsSource="{Binding AvailableInterfaces}"
                          SelectedItem="{Binding SelectedInterface}"
                          Width="290" Margin="0,0,10,0"/>
                <Button Content="▣ Escanear red" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ScanCommand}"/>
            </StackPanel>
        </DockPanel>

        <!-- Estado operativo visible para el técnico. -->
        <TextBlock Grid.Row="1" Text="{Binding StatusText}" Foreground="{StaticResource TextDimBrush}"
                   FontFamily="Consolas" FontSize="12" Margin="0,0,0,10"/>

        <!-- Tabla principal de dispositivos encontrados. -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6">
            <DataGrid ItemsSource="{Binding Devices}" BorderThickness="0" IsReadOnly="True"
                      SelectedItem="{Binding SelectedDevice}"
                      AutoGenerateColumns="False"
                      CanUserResizeRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ESTADO" Binding="{Binding Status}" Width="90"/>
                    <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="125"/>
                    <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="160"/>
                    <DataGridTextColumn Header="FABRICANTE" Binding="{Binding Manufacturer}" Width="130"/>
                    <DataGridTextColumn Header="MODELO" Binding="{Binding Model}" Width="155"/>
                    <DataGridTextColumn Header="FIRMWARE" Binding="{Binding Firmware}" Width="110"/>
                    <DataGridTextColumn Header="ONVIF" Binding="{Binding OnvifSupported}" Width="75"/>
                    <DataGridTextColumn Header="WS-DISCOVERY" Binding="{Binding DiscoveredByOnvif}" Width="105"/>
                    <DataGridTextColumn Header="RTSP" Binding="{Binding RtspSupported}" Width="70"/>
                    <DataGridTextColumn Header="DEVICE SERVICE" Binding="{Binding OnvifDeviceServiceXAddr}" Width="280"/>
                    <DataGridTextColumn Header="ÚLT. VISTO" Binding="{Binding LastSeenAt}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Panel técnico del dispositivo seleccionado. Los datos se actualizan progresivamente. -->
        <Border Grid.Row="3" Margin="0,10,0,0"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6"
                Padding="14">
            <Grid DataContext="{Binding SelectedDevice}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="DETALLE DEL DISPOSITIVO"
                               FontFamily="Consolas"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock DockPanel.Dock="Right"
                               Text="Capacidades detectadas automáticamente"
                               Foreground="{StaticResource TextDimBrush}"
                               FontFamily="Consolas"
                               FontSize="11"/>
                </DockPanel>

                <!-- Identidad principal. -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" Text="IP" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding IpAddress}" FontFamily="Consolas"/>
                    <TextBlock Grid.Column="2" Text="MAC" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                    <TextBlock Grid.Column="3" Text="{Binding MacAddress}" FontFamily="Consolas"/>
                    <TextBlock Grid.Column="4" Text="ESTADO" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                    <TextBlock Grid.Column="5" Text="{Binding Status}" FontFamily="Consolas" FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="FABRICANTE" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Manufacturer}" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="MODELO" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Model}" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="4" Text="SERIAL" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="5" Text="{Binding SerialNumber}" FontFamily="Consolas" Margin="0,8,0,0"/>
                </Grid>

                <!-- Capacidades. Cada campo es un resumen booleano de un servicio ONVIF real. -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ONVIF  ✓" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Grid.Column="1" Text="MEDIA  {Binding HasMediaService}" FontFamily="Consolas"/>
                    <TextBlock Grid.Column="2" Text="IMAGING  {Binding HasImagingService}" FontFamily="Consolas"/>
                    <TextBlock Grid.Column="3" Text="PTZ  {Binding HasPtzService}" FontFamily="Consolas"/>
                    <TextBlock Grid.Column="4" Text="EVENTS  {Binding HasEventsService}" FontFamily="Consolas"/>
                </Grid>

                <!-- XAddrs reales publicados por la cámara. -->
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="DEVICE SERVICE" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OnvifDeviceServiceXAddr}" FontFamily="Consolas" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="MEDIA SERVICE" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OnvifMediaServiceXAddr}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="PTZ / EVENTS" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OnvifPtzServiceXAddr} | {Binding OnvifEventsServiceXAddr}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Barra inferior con acciones sobre la cámara seleccionada y estadísticas del escaneo. -->
        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="▶ Obtener URL de stream (Capa 5)"
                        Command="{Binding GetStreamUriCommand}" Margin="10,0,0,0"/>
            </StackPanel>

            <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextDimBrush}">
                <Run Text="Total: "/><Run Text="{Binding Devices.Count, Mode=OneWay}"/>
                <Run Text=" dispositivos · Ping/ARP + WS-Discovery + ONVIF Device/Media"/>
            </TextBlock>
        </DockPanel>
    </Grid>
</Window>
