<Window x:Class="CameraInspector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Camera Inspector"
        Width="1280"
        Height="820"
        MinWidth="1050"
        MinHeight="680"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12" Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="*" MinHeight="330"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABECERA compacta para reservar más espacio al contenido técnico. -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="CAMERA INSPECTOR"
                           FontFamily="Consolas"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="  //  DESCUBRIMIENTO · DIAGNÓSTICO · VIDEO · INVENTARIO"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="{StaticResource TextDimBrush}"
                           Margin="12,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding AvailableInterfaces}"
                          SelectedItem="{Binding SelectedInterface}"
                          Width="315"
                          Height="32"/>
                <Button Content="▣ ESCANEAR RED"
                        Width="145"
                        Height="32"
                        Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ScanCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ESTADO GLOBAL. -->
        <Border Grid.Row="1"
                Padding="9,7"
                Margin="0,0,0,8"
                BorderThickness="1"
                CornerRadius="4"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush2}">
            <TextBlock Text="{Binding StatusText}"
                       FontFamily="Consolas"
                       FontSize="11"
                       Foreground="{StaticResource TextDimBrush}"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- LISTA: altura controlada para garantizar que el detalle siempre permanezca visible. -->
        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1"
                CornerRadius="5">
            <DataGrid ItemsSource="{Binding Devices}"
                      SelectedItem="{Binding SelectedDevice}"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="True"
                      RowHeight="27"
                      ColumnHeaderHeight="29"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ESTADO" Binding="{Binding Status}" Width="80"/>
                    <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="115"/>
                    <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="140"/>
                    <DataGridTextColumn Header="FABRICANTE" Binding="{Binding Manufacturer}" Width="120"/>
                    <DataGridTextColumn Header="MODELO" Binding="{Binding Model}" Width="135"/>
                    <DataGridTextColumn Header="FIRMWARE" Binding="{Binding Firmware}" Width="95"/>
                    <DataGridTextColumn Header="ONVIF" Binding="{Binding OnvifSupported}" Width="60"/>
                    <DataGridTextColumn Header="WS-DISCOVERY" Binding="{Binding DiscoveredByOnvif}" Width="105"/>
                    <DataGridTextColumn Header="RTSP" Binding="{Binding RtspSupported}" Width="55"/>
                    <DataGridTextColumn Header="CAMERA ID" Binding="{Binding CameraId}" Width="80"/>
                    <DataGridTextColumn Header="ÚLT. VISTO" Binding="{Binding LastSeenAt}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- DETALLE: ocupa todo el espacio restante de la ventana. -->
        <Border Grid.Row="3"
                Margin="0,8,0,0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1"
                CornerRadius="5">
            <Grid DataContext="{Binding SelectedDevice}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="11,8,11,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="DETALLE DE CÁMARA"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="  //  " Foreground="{StaticResource TextDimBrush}"/>
                        <TextBlock Text="{Binding Manufacturer}"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding IpAddress}"
                               FontFamily="Consolas"
                               FontSize="11"
                               Foreground="{StaticResource TextDimBrush}"/>
                </Grid>

                <TabControl Grid.Row="1"
                            Margin="7,0,7,7"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush2}">

                    <TabItem Header="GENERAL">
                        <ScrollViewer VerticalScrollBarVisibility="Visible"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="{StaticResource PanelBrush}">
                            <StackPanel Margin="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Column="0" Text="IP" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding IpAddress}" FontFamily="Consolas"/>
                                    <TextBlock Grid.Column="2" Text="MAC" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="3" Text="{Binding MacAddress}" FontFamily="Consolas"/>
                                    <TextBlock Grid.Column="4" Text="ESTADO" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Status}" FontFamily="Consolas"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="FABRICANTE" Margin="0,8,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Manufacturer}" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="MODELO" Margin="0,8,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Model}" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="4" Text="SERIAL" Margin="0,8,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="1" Grid.Column="5" Text="{Binding SerialNumber}" Margin="0,8,0,0" FontFamily="Consolas"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="CAMERA ID" Margin="0,8,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CameraId}" Margin="0,8,0,0" FontFamily="Consolas"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="FIRMWARE" Margin="0,8,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Firmware}" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="4" Text="ÚLT. VISTO" Margin="0,8,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="2" Grid.Column="5" Text="{Binding LastSeenAt}" Margin="0,8,0,0" FontFamily="Consolas"/>
                                </Grid>

                                <TextBlock Text="CAPACIDADES ONVIF" Margin="0,14,0,7" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontWeight="Bold"/>
                                <WrapPanel>
                                    <Border Padding="8,4" Margin="0,0,6,6" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Background="{StaticResource Panel2Brush}"><TextBlock><Run Text="ONVIF  "/><Run Text="{Binding OnvifSupported}" FontFamily="Consolas"/></TextBlock></Border>
                                    <Border Padding="8,4" Margin="0,0,6,6" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Background="{StaticResource Panel2Brush}"><TextBlock><Run Text="MEDIA  "/><Run Text="{Binding HasMediaService}" FontFamily="Consolas"/></TextBlock></Border>
                                    <Border Padding="8,4" Margin="0,0,6,6" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Background="{StaticResource Panel2Brush}"><TextBlock><Run Text="IMAGING  "/><Run Text="{Binding HasImagingService}" FontFamily="Consolas"/></TextBlock></Border>
                                    <Border Padding="8,4" Margin="0,0,6,6" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Background="{StaticResource Panel2Brush}"><TextBlock><Run Text="PTZ  "/><Run Text="{Binding HasPtzService}" FontFamily="Consolas"/></TextBlock></Border>
                                    <Border Padding="8,4" Margin="0,0,6,6" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Background="{StaticResource Panel2Brush}"><TextBlock><Run Text="EVENTS  "/><Run Text="{Binding HasEventsService}" FontFamily="Consolas"/></TextBlock></Border>
                                    <Border Padding="8,4" Margin="0,0,6,6" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Background="{StaticResource Panel2Brush}"><TextBlock><Run Text="RTSP  "/><Run Text="{Binding RtspSupported}" FontFamily="Consolas"/></TextBlock></Border>
                                </WrapPanel>

                                <TextBlock Text="ENDPOINTS ONVIF" Margin="0,12,0,7" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontWeight="Bold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="135"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="DEVICE SERVICE" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OnvifDeviceServiceXAddr}" FontFamily="Consolas" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="MEDIA SERVICE" Margin="0,5,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OnvifMediaServiceXAddr}" Margin="0,5,0,0" FontFamily="Consolas" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="IMAGING SERVICE" Margin="0,5,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OnvifImagingServiceXAddr}" Margin="0,5,0,0" FontFamily="Consolas" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="PTZ SERVICE" Margin="0,5,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OnvifPtzServiceXAddr}" Margin="0,5,0,0" FontFamily="Consolas" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="EVENTS SERVICE" Margin="0,5,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding OnvifEventsServiceXAddr}" Margin="0,5,0,0" FontFamily="Consolas" TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="CREDENCIALES">
                        <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12">
                                <TextBlock Text="SEGURIDAD DEL DISPOSITIVO" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Text="La contraseña se almacena únicamente en Windows Credential Manager. SQLite conserva solo el usuario y la referencia al secreto."/>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="CREDENCIALES" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HasSavedCredentials}" FontFamily="Consolas"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="USUARIO" Margin="0,6,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SavedCredentialUsername}" Margin="0,6,0,0" FontFamily="Consolas"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="ÚLT. VERIFICACIÓN" Margin="0,6,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SavedCredentialLastVerifiedAt}" Margin="0,6,0,0" FontFamily="Consolas"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="GUARDAR / ACTUALIZAR" Command="{Binding DataContext.SaveCredentialsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,7,0"/>
                                    <Button Content="ELIMINAR" Command="{Binding DataContext.DeleteCredentialsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <CheckBox Content="Usar credenciales guardadas" IsChecked="{Binding DataContext.UseSavedCredentials, RelativeSource={RelativeSource AncestorType=Window}}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="VIDEO">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="10">
                                <Border Height="250" Background="#020402" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="3">
                                    <vlc:VideoView x:Name="VideoSurface" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                    <Button Content="▶ MAIN STREAM" Command="{Binding DataContext.GetMainStreamUriCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,7,0"/>
                                    <Button Content="▶ SUB STREAM" Command="{Binding DataContext.GetSubStreamUriCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,7,0"/>
                                    <Button Content="■ DETENER" Command="{Binding DataContext.StopVideoCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </StackPanel>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="9" Margin="0,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="MAIN STREAM" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding DataContext.ResolvedMainStream.Resolution, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding DataContext.ResolvedMainStream.Encoding, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <TextBlock Text="{Binding DataContext.ResolvedMainStream.FrameRate, RelativeSource={RelativeSource AncestorType=Window}, StringFormat={}{0} FPS}"/>
                                            <TextBlock Text="{Binding DataContext.ResolvedMainStream.RtspUri, RelativeSource={RelativeSource AncestorType=Window}}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="9" Margin="4,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="SUB STREAM" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding DataContext.ResolvedSubStream.Resolution, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding DataContext.ResolvedSubStream.Encoding, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <TextBlock Text="{Binding DataContext.ResolvedSubStream.FrameRate, RelativeSource={RelativeSource AncestorType=Window}, StringFormat={}{0} FPS}"/>
                                            <TextBlock Text="{Binding DataContext.ResolvedSubStream.RtspUri, RelativeSource={RelativeSource AncestorType=Window}}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="DIAGNÓSTICO">
                        <Grid Margin="9">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,7">
                                <Button Content="🧪 EJECUTAR DIAGNÓSTICO" Command="{Binding DataContext.RunDiagnosticsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <TextBlock Text="Pruebas paralelas + historial" Foreground="{StaticResource TextDimBrush}" Margin="12,4,0,0"/>
                            </StackPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding DataContext.DiagnosticResults, RelativeSource={RelativeSource AncestorType=Window}}" AutoGenerateColumns="False" IsReadOnly="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PRUEBA" Binding="{Binding TestName}" Width="130"/>
                                    <DataGridTextColumn Header="OK" Binding="{Binding Success}" Width="50"/>
                                    <DataGridTextColumn Header="NO SOPORTADO" Binding="{Binding NotSupported}" Width="105"/>
                                    <DataGridTextColumn Header="DURACIÓN" Binding="{Binding Duration}" Width="95"/>
                                    <DataGridTextColumn Header="MENSAJE" Binding="{Binding Message}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="HISTORIAL">
                        <Grid Margin="9">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,7">
                                <Button Content="↻ ACTUALIZAR HISTORIAL" Command="{Binding DataContext.RefreshHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <TextBlock Text="Últimos 100 resultados" Foreground="{StaticResource TextDimBrush}" Margin="12,4,0,0"/>
                            </StackPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding DataContext.DiagnosticHistory, RelativeSource={RelativeSource AncestorType=Window}}" AutoGenerateColumns="False" IsReadOnly="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="FECHA" Binding="{Binding TestDate}" Width="165"/>
                                    <DataGridTextColumn Header="PRUEBA" Binding="{Binding TestName}" Width="130"/>
                                    <DataGridTextColumn Header="RESULTADO" Binding="{Binding Result}" Width="95"/>
                                    <DataGridTextColumn Header="MS" Binding="{Binding ResponseTimeMs}" Width="65"/>
                                    <DataGridTextColumn Header="DETALLE" Binding="{Binding Message}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,6,0,0">
            <TextBlock FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextDimBrush}">
                <Run Text="CÁMARAS VISIBLES: "/><Run Text="{Binding Devices.Count, Mode=OneWay}"/>
                <Run Text="  ·  ONVIF + WS-DISCOVERY + RTSP + DIAGNÓSTICO + SQLITE"/>
            </TextBlock>
        </DockPanel>
    </Grid>
</Window>
