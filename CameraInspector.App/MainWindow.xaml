<Window x:Class="CameraInspector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Camera Inspector" Height="1100" Width="1500"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*" MinHeight="280"/>
            <RowDefinition Height="3*" MinHeight="430"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado principal. -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="CAMERA INSPECTOR"
                           FontFamily="Consolas"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text=" — Descubrimiento · Diagnóstico · Video · Inventario"
                           FontSize="13"
                           Foreground="{StaticResource TextDimBrush}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right">
                <ComboBox ItemsSource="{Binding AvailableInterfaces}"
                          SelectedItem="{Binding SelectedInterface}"
                          Width="300"
                          Margin="0,0,10,0"/>
                <Button Content="▣ Escanear red"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ScanCommand}"/>
            </StackPanel>
        </DockPanel>

        <!-- Estado operativo global. -->
        <Border Grid.Row="1"
                BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="10"
                Margin="0,0,0,10">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{StaticResource TextDimBrush}"
                       FontFamily="Consolas"
                       FontSize="12"/>
        </Border>

        <!-- Inventario de dispositivos encontrados durante el escaneo actual. -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1"
                CornerRadius="6">
            <DataGrid ItemsSource="{Binding Devices}"
                      SelectedItem="{Binding SelectedDevice}"
                      BorderThickness="0"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ESTADO" Binding="{Binding Status}" Width="90"/>
                    <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="125"/>
                    <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="160"/>
                    <DataGridTextColumn Header="FABRICANTE" Binding="{Binding Manufacturer}" Width="130"/>
                    <DataGridTextColumn Header="MODELO" Binding="{Binding Model}" Width="155"/>
                    <DataGridTextColumn Header="FIRMWARE" Binding="{Binding Firmware}" Width="110"/>
                    <DataGridTextColumn Header="ONVIF" Binding="{Binding OnvifSupported}" Width="75"/>
                    <DataGridTextColumn Header="WS-DISCOVERY" Binding="{Binding DiscoveredByOnvif}" Width="105"/>
                    <DataGridTextColumn Header="RTSP" Binding="{Binding RtspSupported}" Width="70"/>
                    <DataGridTextColumn Header="CAMERA ID" Binding="{Binding CameraId}" Width="90"/>
                    <DataGridTextColumn Header="ÚLT. VISTO" Binding="{Binding LastSeenAt}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Panel completo de la cámara seleccionada. -->
        <Border Grid.Row="3"
                Margin="0,10,0,0"
                BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid DataContext="{Binding SelectedDevice}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Título del dispositivo seleccionado. -->
                <DockPanel Grid.Row="0" Margin="14,12,14,8">
                    <TextBlock Text="DETALLE DE CÁMARA"
                               FontFamily="Consolas"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding Manufacturer}"
                               Foreground="{StaticResource TextDimBrush}"
                               FontFamily="Consolas"/>
                </DockPanel>

                <TabControl Grid.Row="1" Margin="12,0,12,12">
                    <!-- TAB GENERAL -->
                    <TabItem Header="General">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Identidad. -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Column="0" Text="IP" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding IpAddress}" FontFamily="Consolas"/>
                                    <TextBlock Grid.Column="2" Text="MAC" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding MacAddress}" FontFamily="Consolas"/>
                                    <TextBlock Grid.Column="4" Text="ESTADO" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Status}" FontFamily="Consolas"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="FABRICANTE" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="0,10,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Manufacturer}" Margin="0,10,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="MODELO" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="0,10,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Model}" Margin="0,10,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="4" Text="SERIAL" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="0,10,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="5" Text="{Binding SerialNumber}" FontFamily="Consolas" Margin="0,10,0,0"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="CAMERA ID" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="0,10,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CameraId}" FontFamily="Consolas" Margin="0,10,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="FIRMWARE" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="0,10,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Firmware}" Margin="0,10,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="4" Text="ÚLT. VISTO" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="0,10,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="5" Text="{Binding LastSeenAt}" FontFamily="Consolas" Margin="0,10,0,0"/>
                                </Grid>

                                <!-- Capacidades ONVIF. -->
                                <WrapPanel Grid.Row="1" Margin="0,18,0,0">
                                    <Border Padding="10,6" Margin="0,0,8,8" CornerRadius="4" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                                        <TextBlock><Run Text="ONVIF  "/><Run Text="{Binding OnvifSupported}" FontFamily="Consolas"/></TextBlock>
                                    </Border>
                                    <Border Padding="10,6" Margin="0,0,8,8" CornerRadius="4" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                                        <TextBlock><Run Text="MEDIA  "/><Run Text="{Binding HasMediaService}" FontFamily="Consolas"/></TextBlock>
                                    </Border>
                                    <Border Padding="10,6" Margin="0,0,8,8" CornerRadius="4" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                                        <TextBlock><Run Text="IMAGING  "/><Run Text="{Binding HasImagingService}" FontFamily="Consolas"/></TextBlock>
                                    </Border>
                                    <Border Padding="10,6" Margin="0,0,8,8" CornerRadius="4" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                                        <TextBlock><Run Text="PTZ  "/><Run Text="{Binding HasPtzService}" FontFamily="Consolas"/></TextBlock>
                                    </Border>
                                    <Border Padding="10,6" Margin="0,0,8,8" CornerRadius="4" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                                        <TextBlock><Run Text="EVENTS  "/><Run Text="{Binding HasEventsService}" FontFamily="Consolas"/></TextBlock>
                                    </Border>
                                    <Border Padding="10,6" Margin="0,0,8,8" CornerRadius="4" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                                        <TextBlock><Run Text="RTSP  "/><Run Text="{Binding RtspSupported}" FontFamily="Consolas"/></TextBlock>
                                    </Border>
                                </WrapPanel>

                                <!-- Endpoints reales publicados por ONVIF. -->
                                <Grid Grid.Row="2" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="DEVICE SERVICE" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OnvifDeviceServiceXAddr}" FontFamily="Consolas" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="MEDIA SERVICE" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="0,7,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OnvifMediaServiceXAddr}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="IMAGING SERVICE" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="0,7,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OnvifImagingServiceXAddr}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="PTZ SERVICE" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="0,7,0,0"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OnvifPtzServiceXAddr}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="EVENTS SERVICE" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="0,7,0,0"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding OnvifEventsServiceXAddr}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB CREDENCIALES -->
                    <TabItem Header="Credenciales">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="SEGURIDAD DEL DISPOSITIVO"
                                       FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>

                            <TextBlock Grid.Row="1" Margin="0,12,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextDimBrush}"
                                       Text="La contraseña se almacena únicamente en Windows Credential Manager. SQLite conserva solo el usuario y una referencia al secreto."/>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
                                <TextBlock Text="Guardadas: " FontWeight="Bold"/>
                                <TextBlock Text="{Binding HasSavedCredentials}" FontFamily="Consolas" Margin="4,0,18,0"/>
                                <TextBlock Text="Usuario: " FontWeight="Bold"/>
                                <TextBlock Text="{Binding SavedCredentialUsername}" FontFamily="Consolas" Margin="4,0,18,0"/>
                                <TextBlock Text="Última verificación: " FontWeight="Bold"/>
                                <TextBlock Text="{Binding SavedCredentialLastVerifiedAt}" FontFamily="Consolas" Margin="4,0,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="Guardar / actualizar"
                                        Command="{Binding DataContext.SaveCredentialsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Margin="0,0,8,0"/>
                                <Button Content="Eliminar"
                                        Command="{Binding DataContext.DeleteCredentialsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Margin="0,0,18,0"/>
                                <CheckBox Content="Usar credenciales guardadas automáticamente"
                                          IsChecked="{Binding DataContext.UseSavedCredentials, RelativeSource={RelativeSource AncestorType=Window}}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Grid.Row="4" Margin="0,18,0,0" Padding="12"
                                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="5">
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}"
                                           Text="Al guardar, el secreto anterior se elimina del almacén seguro y se reemplaza por el nuevo. La aplicación no muestra ni registra la contraseña después de cerrar el diálogo."/>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- TAB VIDEO -->
                    <TabItem Header="Video">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" MinHeight="260"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="Black" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="4">
                                <vlc:VideoView x:Name="VideoSurface"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch"/>
                            </Border>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="▶ Main Stream"
                                        Command="{Binding DataContext.GetMainStreamUriCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Margin="0,0,8,0"/>
                                <Button Content="▶ Sub Stream"
                                        Command="{Binding DataContext.GetSubStreamUriCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Margin="0,0,8,0"/>
                                <Button Content="■ Detener"
                                        Command="{Binding DataContext.StopVideoCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </StackPanel>

                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Margin="0,0,6,0" Padding="10" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Text="MAIN STREAM" FontFamily="Consolas" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding DataContext.ResolvedMainStream.Resolution, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <TextBlock Text="{Binding DataContext.ResolvedMainStream.Encoding, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <TextBlock Text="{Binding DataContext.ResolvedMainStream.FrameRate, RelativeSource={RelativeSource AncestorType=Window}, StringFormat={}{0} FPS}"/>
                                        <TextBlock Text="{Binding DataContext.ResolvedMainStream.RtspUri, RelativeSource={RelativeSource AncestorType=Window}}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Margin="6,0,0,0" Padding="10" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Text="SUB STREAM" FontFamily="Consolas" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding DataContext.ResolvedSubStream.Resolution, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <TextBlock Text="{Binding DataContext.ResolvedSubStream.Encoding, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <TextBlock Text="{Binding DataContext.ResolvedSubStream.FrameRate, RelativeSource={RelativeSource AncestorType=Window}, StringFormat={}{0} FPS}"/>
                                        <TextBlock Text="{Binding DataContext.ResolvedSubStream.RtspUri, RelativeSource={RelativeSource AncestorType=Window}}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- TAB DIAGNÓSTICO -->
                    <TabItem Header="Diagnóstico">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" MinHeight="220"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="🧪 Ejecutar diagnóstico"
                                        Command="{Binding DataContext.RunDiagnosticsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Margin="0,0,8,0"/>
                                <TextBlock Text="Las pruebas se ejecutan en paralelo y se almacenan en el historial."
                                           Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding DataContext.DiagnosticResults, RelativeSource={RelativeSource AncestorType=Window}}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserResizeRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PRUEBA" Binding="{Binding TestName}" Width="150"/>
                                    <DataGridTextColumn Header="OK" Binding="{Binding Success}" Width="70"/>
                                    <DataGridTextColumn Header="NO SOPORTADO" Binding="{Binding NotSupported}" Width="110"/>
                                    <DataGridTextColumn Header="DURACIÓN" Binding="{Binding Duration}" Width="120"/>
                                    <DataGridTextColumn Header="MENSAJE" Binding="{Binding Message}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- TAB HISTORIAL -->
                    <TabItem Header="Historial">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" MinHeight="220"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="↻ Actualizar historial"
                                        Command="{Binding DataContext.RefreshHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Margin="0,0,8,0"/>
                                <TextBlock Text="Últimos 100 resultados"
                                           Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding DataContext.DiagnosticHistory, RelativeSource={RelativeSource AncestorType=Window}}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserResizeRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="FECHA" Binding="{Binding TestDate}" Width="180"/>
                                    <DataGridTextColumn Header="PRUEBA" Binding="{Binding TestName}" Width="150"/>
                                    <DataGridTextColumn Header="RESULTADO" Binding="{Binding Result}" Width="100"/>
                                    <DataGridTextColumn Header="MS" Binding="{Binding ResponseTimeMs}" Width="80"/>
                                    <DataGridTextColumn Header="DETALLE" Binding="{Binding Message}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <!-- Estadísticas inferiores. -->
        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextDimBrush}">
                <Run Text="Dispositivos encontrados: "/><Run Text="{Binding Devices.Count, Mode=OneWay}"/>
                <Run Text=" · ONVIF + WS-Discovery + RTSP + diagnóstico + inventario SQLite"/>
            </TextBlock>
        </DockPanel>
    </Grid>
</Window>
