<Window x:Class="CameraInspector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Inspector"
        Width="1280"
        Height="820"
        MinWidth="1050"
        MinHeight="680"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12" Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="*" MinHeight="330"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABECERA compacta para reservar más espacio al contenido técnico. -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="CAMERA INSPECTOR" FontFamily="Consolas" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="  //  DESCUBRIMIENTO · DIAGNÓSTICO · VIDEO · INVENTARIO" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="12,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding AvailableInterfaces}" SelectedItem="{Binding SelectedInterface}" Width="315" Height="32"/>
                <Button Content="▣ ESCANEAR RED" Width="145" Height="32" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ESTADO GLOBAL. -->
        <Border Grid.Row="1" Padding="9,7" Margin="0,0,0,8" BorderThickness="1" CornerRadius="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}">
            <TextBlock Text="{Binding StatusText}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
        </Border>

        <!-- LISTA: altura controlada para garantizar que el detalle siempre permanezca visible. -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="5">
            <DataGrid ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" CanUserResizeRows="False" CanUserSortColumns="True" RowHeight="27" ColumnHeaderHeight="29" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ESTADO" Binding="{Binding Status}" Width="80"/>
                    <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="115"/>
                    <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="140"/>
                    <DataGridTextColumn Header="FABRICANTE" Binding="{Binding Manufacturer}" Width="120"/>
                    <DataGridTextColumn Header="MODELO" Binding="{Binding Model}" Width="135"/>
                    <DataGridTextColumn Header="FIRMWARE" Binding="{Binding Firmware}" Width="95"/>
                    <DataGridTextColumn Header="EVIDENCIA" Binding="{Binding DetectionReason}" Width="220"/>
                    <DataGridTextColumn Header="ONVIF" Binding="{Binding OnvifSupported}" Width="60"/>
                    <DataGridTextColumn Header="WS-DISCOVERY" Binding="{Binding DiscoveredByOnvif}" Width="105"/>
                    <DataGridTextColumn Header="RTSP" Binding="{Binding RtspSupported}" Width="55"/>
                    <DataGridTextColumn Header="CAMERA ID" Binding="{Binding CameraId}" Width="80"/>
                    <DataGridTextColumn Header="ÚLT. VISTO" Binding="{Binding LastSeenAt}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- DETALLE: ocupa todo el espacio restante de la ventana. -->
        <Border Grid.Row="3" Margin="0,8,0,0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="5">
            <Grid DataContext="{Binding SelectedDevice}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="11,8,11,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="DETALLE DE CÁMARA" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="  //  " Foreground="{StaticResource TextDimBrush}"/>
                        <TextBlock Text="{Binding Manufacturer}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding IpAddress}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                </Grid>

                <TabControl x:Name="DeviceDetailTabs" Grid.Row="1" Margin="7,0,7,7" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" SelectionChanged="DeviceDetailTabs_SelectionChanged">
                    <TabItem Header="GENERAL">
                        <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource PanelBrush}">
                            <StackPanel Margin="12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="190"/><ColumnDefinition Width="95"/><ColumnDefinition Width="190"/><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Column="0" Text="IP" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding IpAddress}" FontFamily="Consolas"/>
                                    <TextBlock Grid.Column="2" Text="MAC" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="3" Text="{Binding MacAddress}" FontFamily="Consolas"/>
                                    <TextBlock Grid.Column="4" Text="ESTADO" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Status}" FontFamily="Consolas"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="FABRICANTE" Margin="0,8,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Manufacturer}" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="MODELO" Margin="0,8,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Model}" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="4" Text="SERIAL" Margin="0,8,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="1" Grid.Column="5" Text="{Binding SerialNumber}" Margin="0,8,0,0" FontFamily="Consolas"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="CAMERA ID" Margin="0,8,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CameraId}" Margin="0,8,0,0" FontFamily="Consolas"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="FIRMWARE" Margin="0,8,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Firmware}" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="4" Text="ÚLT. VISTO" Margin="0,8,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="2" Grid.Column="5" Text="{Binding LastSeenAt}" Margin="0,8,0,0" FontFamily="Consolas"/>
                                </Grid>

                                <TextBlock Text="MÉTODOS DE DETECCIÓN" Margin="0,14,0,7" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontWeight="Bold"/>
                                <Border Padding="9" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                                    <TextBlock Text="{Binding DetectionDetails}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock Text="CAPACIDADES ONVIF" Margin="0,14,0,7" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontWeight="Bold"/>
                                <WrapPanel>
                                    <Border Padding="8,4" Margin="0,0,6,6" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Background="{StaticResource Panel2Brush}"><TextBlock><Run Text="ONVIF  "/><Run Text="{Binding OnvifSupported}" FontFamily="Consolas"/></TextBlock></Border>
                                    <Border Padding="8,4" Margin="0,0,6,6" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Background="{StaticResource Panel2Brush}"><TextBlock><Run Text="MEDIA  "/><Run Text="{Binding HasMediaService}" FontFamily="Consolas"/></TextBlock></Border>
                                    <Border Padding="8,4" Margin="0,0,6,6" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Background="{StaticResource Panel2Brush}"><TextBlock><Run Text="IMAGING  "/><Run Text="{Binding HasImagingService}" FontFamily="Consolas"/></TextBlock></Border>
                                    <Border Padding="8,4" Margin="0,0,6,6" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Background="{StaticResource Panel2Brush}"><TextBlock><Run Text="PTZ  "/><Run Text="{Binding HasPtzService}" FontFamily="Consolas"/></TextBlock></Border>
                                    <Border Padding="8,4" Margin="0,0,6,6" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Background="{StaticResource Panel2Brush}"><TextBlock><Run Text="EVENTS  "/><Run Text="{Binding HasEventsService}" FontFamily="Consolas"/></TextBlock></Border>
                                    <Border Padding="8,4" Margin="0,0,6,6" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Background="{StaticResource Panel2Brush}"><TextBlock><Run Text="RTSP  "/><Run Text="{Binding RtspSupported}" FontFamily="Consolas"/></TextBlock></Border>
                                </WrapPanel>

                                <TextBlock Text="ENDPOINTS ONVIF" Margin="0,12,0,7" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontWeight="Bold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="DEVICE SERVICE" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OnvifDeviceServiceXAddr}" FontFamily="Consolas" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="MEDIA SERVICE" Margin="0,5,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OnvifMediaServiceXAddr}" Margin="0,5,0,0" FontFamily="Consolas" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="IMAGING SERVICE" Margin="0,5,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OnvifImagingServiceXAddr}" Margin="0,5,0,0" FontFamily="Consolas" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="PTZ SERVICE" Margin="0,5,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OnvifPtzServiceXAddr}" Margin="0,5,0,0" FontFamily="Consolas" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="EVENTS SERVICE" Margin="0,5,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding OnvifEventsServiceXAddr}" Margin="0,5,0,0" FontFamily="Consolas" TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="CREDENCIALES">
                        <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12">
                                <TextBlock Text="SEGURIDAD DEL DISPOSITIVO" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Text="La contraseña se almacena únicamente en Windows Credential Manager. SQLite conserva solo el usuario y la referencia al secreto."/>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="CREDENCIALES" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HasSavedCredentials}" FontFamily="Consolas"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="USUARIO" Margin="0,6,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SavedCredentialUsername}" Margin="0,6,0,0" FontFamily="Consolas"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="ÚLT. VERIFICACIÓN" Margin="0,6,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SavedCredentialLastVerifiedAt}" Margin="0,6,0,0" FontFamily="Consolas"/>
                                    <CheckBox Grid.Row="2" Grid.Column="1" Content="Usar credenciales guardadas automáticamente" IsChecked="{Binding UseSavedCredentials}" Margin="0,28,0,0"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem x:Name="IpVideoTab" Header="VIDEO">
                        <Grid Margin="10">
                            <Border Background="{StaticResource Panel2Brush}"
                                    BorderBrush="{StaticResource BorderAccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="24">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="VIDEO / CÁMARA IP"
                                                   FontFamily="Consolas"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Margin="0,6,0,0"
                                                   Text="El reproductor IP se abre en una ventana independiente."
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="13"/>
                                        <TextBlock Margin="0,5,0,0"
                                                   Text="La ventana incluye preview, snapshot, grabación, detener preview, detener grabación e información."
                                                   Foreground="{StaticResource TextDimBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Border Grid.Row="1"
                                            Margin="0,18,0,0"
                                            Padding="12"
                                            Background="{StaticResource Panel3Brush}"
                                            BorderBrush="{StaticResource BorderBrush2}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="CÁMARA" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Manufacturer}" FontFamily="Consolas"/>
                                            <TextBlock Grid.Column="2" Text="IP" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="3" Text="{Binding IpAddress}" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="▶"
                                                   FontFamily="Consolas"
                                                   FontSize="42"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="ABRIR REPRODUCTOR IP"
                                                   FontFamily="Consolas"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="Seleccione una cámara en la lista y vuelva a pulsar VIDEO."
                                                   Margin="0,7,0,0"
                                                   Foreground="{StaticResource TextDimBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <Button Grid.Row="3"
                                            Content="ABRIR VENTANA DE VIDEO"
                                            Command="{x:Null}"
                                            Click="OpenIpVideoFromPanel_Click"
                                            Width="205"
                                            Height="38"
                                            HorizontalAlignment="Center"
                                            Margin="0,18,0,0"
                                            Style="{StaticResource PrimaryButton}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="DIAGNÓSTICO">
                        <Grid Margin="10">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Button Grid.Row="0" Content="⚙ EJECUTAR DIAGNÓSTICO" Command="{Binding DataContext.RunDiagnosticsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                            <DataGrid Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding DataContext.DiagnosticResults, RelativeSource={RelativeSource AncestorType=Window}}" IsReadOnly="True" AutoGenerateColumns="True"/>
                            <TextBlock Grid.Row="2" Text="Las pruebas requieren credenciales válidas cuando el servicio las solicita." Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0"/>
                        </Grid>
                    </TabItem>

                    <TabItem Header="HISTORIAL">
                        <Grid Margin="10">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Button Grid.Row="0" Content="↻ ACTUALIZAR" Command="{Binding DataContext.RefreshHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left"/>
                            <DataGrid Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding DataContext.DiagnosticHistory, RelativeSource={RelativeSource AncestorType=Window}}" IsReadOnly="True" AutoGenerateColumns="True"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0">
            <Button Content="▣ GUARDAR CREDENCIALES" Command="{Binding SaveCredentialsCommand}" Margin="0,0,6,0"/>
            <Button Content="✕ ELIMINAR CREDENCIALES" Command="{Binding DeleteCredentialsCommand}"/>
        </StackPanel>
    </Grid>
</Window>
