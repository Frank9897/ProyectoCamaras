<Window x:Class="CameraInspector.App.CameraAccessSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:responsive="clr-namespace:CameraInspector.App.Responsive"
        responsive:ResponsiveWindowBehavior.Enable="True"
        Title="Camera Inspector — Configurar acceso"
        Width="560"
        Height="550"
        MinWidth="430"
        MinHeight="450"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18">
            <TextBlock Text="CONFIGURAR ACCESO DE LA CÁMARA"
                       FontFamily="Consolas"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"
                       TextWrapping="Wrap"/>
            <TextBlock Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextDimBrush}">
                <Run Text="Esta operación modifica la cuenta administrativa de la propia cámara VIVOTEK. "/>
                <Run Text="No es solamente una credencial local de Camera Inspector." Foreground="{StaticResource WarnBrush}"/>
            </TextBlock>

            <Border Margin="0,14,0,14"
                    Padding="11"
                    Background="{StaticResource Panel2Brush}"
                    BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="CÁMARA"
                               FontFamily="Consolas"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Margin="0,5,0,0" TextWrapping="Wrap">
                        <Run Text="IP: "/>
                        <Run Text="{Binding CameraIpAddress, Mode=OneWay}" FontFamily="Consolas"/>
                    </TextBlock>
                    <TextBlock Margin="0,2,0,0" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap">
                        <Run Text="Fabricante: "/>
                        <Run Text="{Binding CameraManufacturer, Mode=OneWay}"/>
                        <Run Text=" · Modelo: "/>
                        <Run Text="{Binding CameraModel, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <StackPanel Margin="0,0,0,11">
                <TextBlock Text="CONTRASEÑA ROOT ACTUAL"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextDimBrush}"/>
                <PasswordBox x:Name="CurrentPasswordBox"
                             Margin="0,6,0,0"
                             MinHeight="34"
                             ToolTip="Déjela vacía si la cámara todavía usa root sin contraseña."/>
            </StackPanel>

            <StackPanel Margin="0,0,0,11">
                <TextBlock Text="NUEVA CONTRASEÑA ROOT"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextDimBrush}"/>
                <PasswordBox x:Name="NewPasswordBox"
                             Margin="0,6,0,0"
                             MinHeight="34"
                             ToolTip="Mínimo 4 caracteres."/>
            </StackPanel>

            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="CONFIRMAR NUEVA CONTRASEÑA"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextDimBrush}"/>
                <PasswordBox x:Name="ConfirmPasswordBox"
                             Margin="0,6,0,0"
                             MinHeight="34"/>
            </StackPanel>

            <Border Padding="11"
                    Background="{StaticResource Panel3Brush}"
                    BorderBrush="{StaticResource WarnBrush}"
                    BorderThickness="1">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}">
                    <Run Text="IMPORTANTE: " FontWeight="Bold"/>
                    <Run Text="al cambiar la contraseña root, la cámara pasará a exigir esa contraseña para las operaciones administrativas. Camera Inspector guardará la misma credencial de forma segura en Windows Credential Manager."/>
                </TextBlock>
            </Border>

            <TextBlock x:Name="StatusTextBlock"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"
                       FontFamily="Consolas"
                       FontSize="10"
                       Foreground="{StaticResource TextDimBrush}"/>

            <WrapPanel HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="CANCELAR"
                        MinWidth="105"
                        Margin="0,0,8,5"
                        Click="CancelButton_Click"/>
                <Button x:Name="ApplyButton"
                        Content="CONFIGURAR ACCESO"
                        MinWidth="175"
                        Margin="0,0,0,5"
                        Style="{StaticResource PrimaryButton}"
                        Click="ApplyButton_Click"/>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Window>