<Window x:Class="CameraInspector.App.IpCameraVideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Camera Inspector — Video IP"
        Width="1200"
        Height="820"
        MinWidth="760"
        MinHeight="560"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Margin="14" MinWidth="720">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="VIDEO / CÁMARA IP" FontFamily="Consolas" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"><Run Text="IP: "/><Run Text="{Binding SelectedDevice.IpAddress}" FontFamily="Consolas"/></TextBlock>
                    <TextBlock Margin="0,2,0,0" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"><Run Text="Fabricante: "/><Run Text="{Binding SelectedDevice.Manufacturer}"/><Run Text="  ·  Modelo: "/><Run Text="{Binding SelectedDevice.Model}"/></TextBlock>
                    <WrapPanel Margin="0,10,0,0">
                        <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource BorderAccentBrush}" BorderThickness="1" CornerRadius="3" Padding="10,6" Margin="0,0,8,5">
                            <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="REPRODUCTOR IP" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/></StackPanel>
                        </Border>
                        <Button x:Name="HealthButton" Content="↻ COMPROBAR SALUD" Click="HealthButton_Click" MinWidth="155" Height="34" Margin="0,0,0,5" Style="{StaticResource SecondaryButton}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="DISPOSITIVO" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <Border Margin="0,10,0,0" Padding="10" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="DIRECCIÓN IP" Foreground="{StaticResource TextDimBrush}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedDevice.IpAddress}" FontFamily="Consolas" FontSize="17" Foreground="{StaticResource TextBrush}" Margin="0,3,0,8"/>
                                    <TextBlock Text="MAC" Foreground="{StaticResource TextDimBrush}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedDevice.MacAddress}" FontFamily="Consolas" Margin="0,3,0,8" TextWrapping="Wrap"/>
                                    <TextBlock Text="ESTADO" Foreground="{StaticResource TextDimBrush}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedDevice.HealthDisplay}" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}" Margin="0,3,0,8" TextWrapping="Wrap"/>
                                    <TextBlock Text="COMUNICACIÓN" Foreground="{StaticResource TextDimBrush}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedDevice.CommunicationDisplay}" FontFamily="Consolas" Margin="0,3,0,8" TextWrapping="Wrap"/>
                                    <TextBlock Text="VIDEO" Foreground="{StaticResource TextDimBrush}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedDevice.VideoDisplay}" FontFamily="Consolas" Margin="0,3,0,8" TextWrapping="Wrap"/>
                                    <TextBlock Text="ALERTA" Foreground="{StaticResource TextDimBrush}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedDevice.AlertDisplay}" TextWrapping="Wrap" FontFamily="Consolas" Foreground="{StaticResource WarnBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="OPERACIONES" Margin="0,14,0,7" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <WrapPanel>
                                <Button Content="CONFIG. RED" Click="NetworkButton_Click" MinWidth="120" Height="33" Margin="0,0,5,5" Style="{StaticResource SecondaryButton}"/>
                                <Button Content="IMAGEN" Click="ImagingButton_Click" MinWidth="80" Height="33" Margin="0,0,5,5" Style="{StaticResource SecondaryButton}"/>
                                <Button Content="EVENTOS" Click="EventsButton_Click" MinWidth="85" Height="33" Margin="0,0,5,5" Style="{StaticResource SecondaryButton}"/>
                                <Button Content="PROPIETARIO" Click="ProviderButton_Click" MinWidth="105" Height="33" Margin="0,0,5,5" Style="{StaticResource SecondaryButton}"/>
                                <Button Content="ABRIR WEB" Click="OpenWebButton_Click" MinWidth="105" Height="33" Margin="0,0,5,5" Style="{StaticResource SecondaryButton}"/>
                                <Button Content="COPIAR IP" Click="CopyIpButton_Click" MinWidth="90" Height="33" Margin="0,0,5,5" Style="{StaticResource SecondaryButton}"/>
                            </WrapPanel>
                            <TextBlock Text="PTZ" Margin="0,9,0,7" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <Grid HorizontalAlignment="Center">
                                <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="62"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions>
                                <Button Grid.Row="0" Grid.Column="1" Content="▲" Click="PtzUp_Click" Style="{StaticResource SecondaryButton}" Margin="2"/>
                                <Button Grid.Row="1" Grid.Column="0" Content="◀" Click="PtzLeft_Click" Style="{StaticResource SecondaryButton}" Margin="2"/>
                                <Button Grid.Row="1" Grid.Column="1" Content="■" Click="PtzStop_Click" Style="{StaticResource SecondaryButton}" Margin="2"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="▶" Click="PtzRight_Click" Style="{StaticResource SecondaryButton}" Margin="2"/>
                                <Button Grid.Row="2" Grid.Column="1" Content="▼" Click="PtzDown_Click" Style="{StaticResource SecondaryButton}" Margin="2"/>
                                <Button Grid.Row="3" Grid.Column="0" Content="ZOOM −" Click="PtzZoomOut_Click" Style="{StaticResource SecondaryButton}" Margin="2"/>
                                <Button Grid.Row="3" Grid.Column="2" Content="ZOOM +" Click="PtzZoomIn_Click" Style="{StaticResource SecondaryButton}" Margin="2"/>
                            </Grid>
                            <TextBlock Text="STREAMS" Margin="0,14,0,7" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <Border Padding="10" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="MAIN STREAM" Foreground="{StaticResource TextDimBrush}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ResolvedMainStream.Resolution, StringFormat=Resolución: {0}}" FontFamily="Consolas" Margin="0,3,0,1" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding ResolvedMainStream.Encoding, StringFormat=Codec: {0}}" FontFamily="Consolas" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding ResolvedMainStream.FrameRate, StringFormat=FPS: {0}}" FontFamily="Consolas" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="SUB STREAM" Foreground="{StaticResource TextDimBrush}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ResolvedSubStream.Resolution, StringFormat=Resolución: {0}}" FontFamily="Consolas" Margin="0,3,0,1" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding ResolvedSubStream.Encoding, StringFormat=Codec: {0}}" FontFamily="Consolas" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding ResolvedSubStream.FrameRate, StringFormat=FPS: {0}}" FontFamily="Consolas" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="ACCESO" Margin="0,14,0,7" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <WrapPanel>
                                <Button x:Name="CredentialsButton" Content="CREDENCIALES" Click="CredentialsButton_Click" MinWidth="125" Height="34" Margin="0,0,5,5" Style="{StaticResource SecondaryButton}"/>
                                <Button Content="DIAGNÓSTICO" Click="DiagnosticsButton_Click" MinWidth="105" Height="34" Margin="0,0,5,5" Style="{StaticResource SecondaryButton}"/>
                            </WrapPanel>
                            <TextBlock Text="Las credenciales se almacenan en Windows Credential Manager." Margin="0,3,0,0" Foreground="{StaticResource TextDimBrush}" FontSize="10" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Row="1" Background="#000000" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="5" MinHeight="320">
                    <Grid>
                        <vlc:VideoView x:Name="VideoSurface" Background="#000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="9,5" Background="#CC030604" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="3">
                            <TextBlock Text="RTSP / IP" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,0,0,0">
                <WrapPanel Margin="0,0,0,8">
                    <Button x:Name="MainStreamButton" Content="▶ MAIN STREAM" Command="{Binding GetMainStreamUriCommand}" MinWidth="125" Height="34" Margin="0,0,6,5" Style="{StaticResource PrimaryButton}"/>
                    <Button x:Name="SubStreamButton" Content="▶ SUB STREAM" Command="{Binding GetSubStreamUriCommand}" MinWidth="120" Height="34" Margin="0,0,6,5" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="SnapshotButton" Content="SNAPSHOT" Click="SnapshotButton_Click" MinWidth="105" Height="34" Margin="0,0,6,5" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="RecordButton" Content="● GRABAR" Click="RecordButton_Click" MinWidth="105" Height="34" Margin="0,0,6,5" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="StopRecordButton" Content="■ FIN GRABACIÓN" Click="StopRecordButton_Click" MinWidth="135" Height="34" Margin="0,0,6,5" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="StopButton" Content="DETENER PREVIEW" Click="StopButton_Click" MinWidth="135" Height="34" Margin="0,0,6,5" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="InfoButton" Content="INFORMACIÓN" Click="InfoButton_Click" MinWidth="110" Height="34" Margin="0,0,6,5" Style="{StaticResource SecondaryButton}"/>
                </WrapPanel>
                <Border Padding="9" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedDevice.HealthMessage}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding StatusText}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>