<Window x:Class="CameraInspector.App.IpCameraVideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:responsive="clr-namespace:CameraInspector.App.Responsive"
        responsive:ResponsiveWindowBehavior.Enable="True"
        Title="Camera Inspector — Video IP"
        Width="1200"
        Height="820"
        MinWidth="620"
        MinHeight="500"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="14"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="VIDEO / CÁMARA IP"
                                   FontFamily="Consolas"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap">
                            <Run Text="IP: "/>
                            <Run Text="{Binding SelectedDevice.IpAddress}" FontFamily="Consolas"/>
                        </TextBlock>
                        <TextBlock Margin="0,2,0,0"
                                   Foreground="{StaticResource TextDimBrush}"
                                   TextWrapping="Wrap">
                            <Run Text="Fabricante: "/>
                            <Run Text="{Binding SelectedDevice.Manufacturer}"/>
                            <Run Text="  ·  Modelo: "/>
                            <Run Text="{Binding SelectedDevice.Model}"/>
                        </TextBlock>
                        <WrapPanel Margin="0,10,0,0">
                            <Border Background="{StaticResource AccentSoftBrush}"
                                    BorderBrush="{StaticResource BorderAccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="10,6"
                                    Margin="0,0,8,5">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8"
                                             Height="8"
                                             Fill="{StaticResource AccentBrush}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,7,0"/>
                                    <TextBlock Text="REPRODUCTOR IP"
                                               FontFamily="Consolas"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="HealthButton"
                                    Content="↻ COMPROBAR SALUD"
                                    Click="HealthButton_Click"
                                    MinWidth="155"
                                    Height="34"
                                    Margin="0,0,0,5"
                                    Style="{StaticResource SecondaryButton}"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Video en vivo y controles principales. En ventanas angostas el bloque se apila automáticamente. -->
            <Border Grid.Row="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="10"
                    Margin="0,0,0,12">
                <Grid x:Name="LiveVideoGrid"
                      SizeChanged="LiveVideoGrid_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="300"/>
                        <ColumnDefinition Width="390"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="320"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="LiveVideoViewport"
                            Grid.Row="0"
                            Grid.Column="0"
                            Background="#000000"
                            BorderBrush="{StaticResource BorderBrush2}"
                            BorderThickness="1"
                            CornerRadius="4"
                            MinHeight="320"
                            Margin="0,0,10,0">
                        <Grid>
                            <vlc:VideoView x:Name="VideoSurface"
                                           Background="#000000"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch"/>
                            <Border HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="12"
                                    Padding="9,5"
                                    Background="#CC030604"
                                    BorderBrush="{StaticResource BorderBrush2}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7"
                                             Height="7"
                                             Fill="{StaticResource AccentBrush}"
                                             Margin="0,0,6,0"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="VIDEO EN VIVO · RTSP / IP"
                                               FontFamily="Consolas"
                                               FontSize="10"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border x:Name="LiveVideoControls"
                            Grid.Row="0"
                            Grid.Column="1"
                            Background="{StaticResource Panel2Brush}"
                            BorderBrush="{StaticResource BorderBrush2}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="CAPTURA Y GRABACIÓN"
                                           FontFamily="Consolas"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="Controle el video en vivo sin salir de esta ventana."
                                           Margin="0,4,0,10"
                                           FontSize="10"
                                           Foreground="{StaticResource TextDimBrush}"
                                           TextWrapping="Wrap"/>

                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="SnapshotButton"
                                            Grid.Column="0"
                                            Content="▣ CAPTURA"
                                            MinHeight="36"
                                            Margin="0,0,4,0"
                                            Click="SnapshotButton_Click"
                                            Style="{StaticResource PrimaryButton}"
                                            ToolTip="Guarda una captura del frame actual."/>
                                    <Button x:Name="RecordButton"
                                            Grid.Column="1"
                                            Content="● VIDEO"
                                            MinHeight="36"
                                            Margin="4,0,0,0"
                                            Click="RecordButton_Click"
                                            Style="{StaticResource SecondaryButton}"
                                            ToolTip="Inicia una grabación del stream IP en formato MP4."/>
                                </Grid>

                                <Border Padding="9"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderBrush2}"
                                        BorderThickness="1"
                                        Margin="0,0,0,9">
                                    <StackPanel>
                                        <TextBlock Text="CAPTURA"
                                                   FontFamily="Consolas"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}"/>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Formato"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextBrush}"
                                                       Margin="0,0,10,0"/>
                                            <ComboBox x:Name="SnapshotFormatCombo"
                                                      Grid.Column="1"
                                                      Height="32"
                                                      SelectedIndex="0"
                                                      MinWidth="120">
                                                <ComboBoxItem Content="PNG (recomendado)" Tag="png"/>
                                                <ComboBoxItem Content="JPEG" Tag="jpg"/>
                                            </ComboBox>
                                        </Grid>
                                        <Button Content="▣ TOMAR CAPTURA"
                                                MinHeight="34"
                                                Margin="0,8,0,0"
                                                Click="SnapshotButton_Click"
                                                Style="{StaticResource SecondaryButton}"/>
                                    </StackPanel>
                                </Border>

                                <Border Padding="9"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderBrush2}"
                                        BorderThickness="1"
                                        Margin="0,0,0,9">
                                    <StackPanel>
                                        <TextBlock Text="VIDEO"
                                                   FontFamily="Consolas"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="Formato de salida: MP4 · compatible con Windows y reproductores comunes."
                                                   Margin="0,5,0,8"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextDimBrush}"
                                                   TextWrapping="Wrap"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="StopRecordButton"
                                                    Grid.Column="0"
                                                    Content="■ FIN GRABACIÓN"
                                                    MinHeight="34"
                                                    Margin="0,0,4,0"
                                                    Click="StopRecordButton_Click"
                                                    Style="{StaticResource SecondaryButton}"/>
                                            <Button x:Name="StopButton"
                                                    Grid.Column="1"
                                                    Content="DETENER PREVIEW"
                                                    MinHeight="34"
                                                    Margin="4,0,0,0"
                                                    Click="StopButton_Click"
                                                    Style="{StaticResource SecondaryButton}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Padding="9"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderBrush2}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="ESTADO DEL VIDEO"
                                                   FontFamily="Consolas"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="{Binding StatusText}"
                                                   Margin="0,5,0,0"
                                                   FontFamily="Consolas"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextDimBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- Información y operaciones de la cámara quedan debajo del video para facilitar la lectura. -->
            <Border Grid.Row="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="DISPOSITIVO"
                               FontFamily="Consolas"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"/>
                    <Border Margin="0,10,0,0"
                            Padding="10"
                            Background="{StaticResource Panel2Brush}"
                            BorderBrush="{StaticResource BorderBrush2}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="DIRECCIÓN IP" Foreground="{StaticResource TextDimBrush}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelectedDevice.IpAddress}" FontFamily="Consolas" FontSize="17" Foreground="{StaticResource TextBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="MAC" Foreground="{StaticResource TextDimBrush}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelectedDevice.MacAddress}" FontFamily="Consolas" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="ESTADO" Foreground="{StaticResource TextDimBrush}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelectedDevice.HealthDisplay}" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="COMUNICACIÓN" Foreground="{StaticResource TextDimBrush}" FontSize="10" FontWeight="Bold" Margin="0,7,0,0"/>
                                <TextBlock Text="{Binding SelectedDevice.CommunicationDisplay}" FontFamily="Consolas" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="VIDEO" Foreground="{StaticResource TextDimBrush}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelectedDevice.VideoDisplay}" FontFamily="Consolas" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="ALERTA" Foreground="{StaticResource TextDimBrush}" FontSize="10" FontWeight="Bold" Margin="0,7,0,0"/>
                                <TextBlock Text="{Binding SelectedDevice.AlertDisplay}" TextWrapping="Wrap" FontFamily="Consolas" Foreground="{StaticResource WarnBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="OPERACIONES" Margin="0,14,0,7" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <WrapPanel>
                        <Button Content="CONFIG. RED" Click="NetworkButton_Click" MinWidth="120" Height="33" Margin="0,0,5,5" Style="{StaticResource SecondaryButton}"/>
                        <Button Content="IMAGEN" Click="ImagingButton_Click" MinWidth="80" Height="33" Margin="0,0,5,5" Style="{StaticResource SecondaryButton}"/>
                        <Button Content="EVENTOS" Click="EventsButton_Click" MinWidth="85" Height="33" Margin="0,0,5,5" Style="{StaticResource SecondaryButton}"/>
                        <Button Content="PROPIETARIO" Click="ProviderButton_Click" MinWidth="105" Height="33" Margin="0,0,5,5" Style="{StaticResource SecondaryButton}"/>
                        <Button Content="ABRIR WEB" Click="OpenWebButton_Click" MinWidth="105" Height="33" Margin="0,0,5,5" Style="{StaticResource SecondaryButton}"/>
                        <Button Content="COPIAR IP" Click="CopyIpButton_Click" MinWidth="90" Height="33" Margin="0,0,5,5" Style="{StaticResource SecondaryButton}"/>
                    </WrapPanel>

                    <TextBlock Text="PTZ" Margin="0,9,0,7" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <Grid HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="62"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Row="0" Grid.Column="1" Content="▲" Click="PtzUp_Click" Style="{StaticResource SecondaryButton}" Margin="2"/>
                        <Button Grid.Row="1" Grid.Column="0" Content="◀" Click="PtzLeft_Click" Style="{StaticResource SecondaryButton}" Margin="2"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="■" Click="PtzStop_Click" Style="{StaticResource SecondaryButton}" Margin="2"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="▶" Click="PtzRight_Click" Style="{StaticResource SecondaryButton}" Margin="2"/>
                        <Button Grid.Row="2" Grid.Column="1" Content="▼" Click="PtzDown_Click" Style="{StaticResource SecondaryButton}" Margin="2"/>
                        <Button Grid.Row="3" Grid.Column="0" Content="ZOOM −" Click="PtzZoomOut_Click" Style="{StaticResource SecondaryButton}" Margin="2"/>
                        <Button Grid.Row="3" Grid.Column="2" Content="ZOOM +" Click="PtzZoomIn_Click" Style="{StaticResource SecondaryButton}" Margin="2"/>
                    </Grid>

                    <TextBlock Text="STREAMS" Margin="0,14,0,7" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <Border Padding="10" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                        <WrapPanel>
                            <StackPanel Margin="0,0,28,8" MinWidth="180">
                                <TextBlock Text="MAIN STREAM" Foreground="{StaticResource TextDimBrush}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ResolvedMainStream.Resolution, StringFormat=Resolución: {0}}" FontFamily="Consolas" Margin="0,3,0,1" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ResolvedMainStream.Encoding, StringFormat=Codec: {0}}" FontFamily="Consolas" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ResolvedMainStream.FrameRate, StringFormat=FPS: {0}}" FontFamily="Consolas" Foreground="{StaticResource TextDimBrush}"/>
                            </StackPanel>
                            <StackPanel MinWidth="180" Margin="0,0,28,8">
                                <TextBlock Text="SUB STREAM" Foreground="{StaticResource TextDimBrush}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ResolvedSubStream.Resolution, StringFormat=Resolución: {0}}" FontFamily="Consolas" Margin="0,3,0,1" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ResolvedSubStream.Encoding, StringFormat=Codec: {0}}" FontFamily="Consolas" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ResolvedSubStream.FrameRate, StringFormat=FPS: {0}}" FontFamily="Consolas" TextWrapping="Wrap"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <TextBlock Text="ACCESO" Margin="0,14,0,7" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <WrapPanel>
                        <Button x:Name="CredentialsButton" Content="CREDENCIALES" Click="CredentialsButton_Click" MinWidth="125" Height="34" Margin="0,0,5,5" Style="{StaticResource SecondaryButton}"/>
                        <Button Content="DIAGNÓSTICO" Click="DiagnosticsButton_Click" MinWidth="105" Height="34" Margin="0,0,5,5" Style="{StaticResource SecondaryButton}"/>
                    </WrapPanel>
                    <TextBlock Text="Las credenciales se almacenan en Windows Credential Manager."
                               Margin="0,3,0,0"
                               Foreground="{StaticResource TextDimBrush}"
                               FontSize="10"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>