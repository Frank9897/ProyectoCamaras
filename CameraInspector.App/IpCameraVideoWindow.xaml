<Window x:Class="CameraInspector.App.IpCameraVideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Camera Inspector — Video IP"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="620"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="12"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="VIDEO / CÁMARA IP"
                               FontFamily="Consolas"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextBrush}">
                        <Run Text="IP: "/><Run Text="{Binding SelectedDevice.IpAddress}" FontFamily="Consolas"/>
                    </TextBlock>
                    <TextBlock Margin="0,2,0,0" Foreground="{StaticResource TextDimBrush}">
                        <Run Text="Fabricante: "/><Run Text="{Binding SelectedDevice.Manufacturer}"/><Run Text="  ·  Modelo: "/><Run Text="{Binding SelectedDevice.Model}"/>
                    </TextBlock>
                </StackPanel>
                <Border Grid.Column="1"
                        Background="{StaticResource AccentSoftBrush}"
                        BorderBrush="{StaticResource BorderAccentBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="12,7"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="REPRODUCTOR IP" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="DISPOSITIVO" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>

                        <Border Margin="0,10,0,0" Padding="10" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="DIRECCIÓN IP" Foreground="{StaticResource TextDimBrush}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelectedDevice.IpAddress}" FontFamily="Consolas" FontSize="17" Foreground="{StaticResource TextBrush}" Margin="0,3,0,8"/>
                                <TextBlock Text="MAC" Foreground="{StaticResource TextDimBrush}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelectedDevice.MacAddress}" FontFamily="Consolas" Margin="0,3,0,8"/>
                                <TextBlock Text="ESTADO" Foreground="{StaticResource TextDimBrush}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelectedDevice.Status}" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="STREAMS" Margin="0,14,0,7" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        <Border Padding="10" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="MAIN STREAM" Foreground="{StaticResource TextDimBrush}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ResolvedMainStream.Resolution, StringFormat=Resolución: {0}}" FontFamily="Consolas" Margin="0,3,0,1"/>
                                <TextBlock Text="{Binding ResolvedMainStream.Encoding, StringFormat=Codec: {0}}" FontFamily="Consolas" Foreground="{StaticResource TextDimBrush}"/>
                                <TextBlock Text="{Binding ResolvedMainStream.FrameRate, StringFormat=FPS: {0}}" FontFamily="Consolas" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="SUB STREAM" Foreground="{StaticResource TextDimBrush}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ResolvedSubStream.Resolution, StringFormat=Resolución: {0}}" FontFamily="Consolas" Margin="0,3,0,1"/>
                                <TextBlock Text="{Binding ResolvedSubStream.Encoding, StringFormat=Codec: {0}}" FontFamily="Consolas" Foreground="{StaticResource TextDimBrush}"/>
                                <TextBlock Text="{Binding ResolvedSubStream.FrameRate, StringFormat=FPS: {0}}" FontFamily="Consolas" Foreground="{StaticResource TextDimBrush}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="ACCESO" Margin="0,14,0,7" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        <Button Content="CREDENCIALES" Command="{Binding SaveCredentialsCommand}" Style="{StaticResource SecondaryButton}" Height="34"/>
                        <TextBlock Text="Usa Windows Credential Manager para almacenar la contraseña de forma segura." Margin="0,8,0,0" Foreground="{StaticResource TextDimBrush}" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="#000000" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <vlc:VideoView x:Name="VideoSurface"
                                   Background="#000000"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"/>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="9,5" Background="#CC030604" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="3">
                        <TextBlock Text="RTSP / IP" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <WrapPanel Margin="0,0,0,8">
                <Button x:Name="MainStreamButton" Content="▶ MAIN STREAM" Command="{Binding GetMainStreamUriCommand}" Width="125" Height="34" Margin="0,0,6,0" Style="{StaticResource PrimaryButton}"/>
                <Button x:Name="SubStreamButton" Content="▶ SUB STREAM" Command="{Binding GetSubStreamUriCommand}" Width="120" Height="34" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}"/>
                <Button x:Name="SnapshotButton" Content="SNAPSHOT" Click="SnapshotButton_Click" Width="105" Height="34" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}"/>
                <Button x:Name="RecordButton" Content="● GRABAR" Click="RecordButton_Click" Width="105" Height="34" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}"/>
                <Button x:Name="StopRecordButton" Content="■ FIN GRABACIÓN" Click="StopRecordButton_Click" Width="135" Height="34" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}"/>
                <Button x:Name="StopButton" Content="DETENER PREVIEW" Click="StopButton_Click" Width="135" Height="34" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}"/>
                <Button x:Name="InfoButton" Content="INFORMACIÓN" Click="InfoButton_Click" Width="110" Height="34" Style="{StaticResource SecondaryButton}"/>
            </WrapPanel>
            <Border Padding="9" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                <TextBlock Text="{Binding StatusText}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>
