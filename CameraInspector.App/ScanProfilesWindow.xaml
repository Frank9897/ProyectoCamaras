<Window x:Class="CameraInspector.App.ScanProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Inspector — Perfiles de escaneo"
        Width="760"
        Height="620"
        MinWidth="620"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="PERFILES DE ESCANEO" FontFamily="Consolas" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="Elegí el alcance según la situación. La RED LOCAL siempre usa la subred de la interfaz seleccionada; RED COMPLETA recorre las interfaces activas." FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="10" Margin="0,0,0,8" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="DIRECTA" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Para una cámara conectada directamente, una IP conocida o un enlace APIPA. No hace un barrido de toda la red." Margin="0,5,0,7" TextWrapping="Wrap"/>
                        <WrapPanel>
                            <TextBlock Text="IP OBJETIVO" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold" Margin="0,0,8,4"/>
                            <TextBox Text="{Binding DirectCameraIp, UpdateSourceTrigger=PropertyChanged}" Width="190" Height="28" Margin="0,0,8,4"/>
                            <Button Content="EJECUTAR DIRECTA" Click="Direct_Click" Height="28" Margin="0,0,0,4"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Padding="10" Margin="0,0,0,8" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="RED LOCAL" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Escanea la red calculada desde la interfaz seleccionada. Ejemplo: PC 192.168.0.106/24 → RED 192.168.0.0/24. La IP del PC no es la red objetivo." Margin="0,5,0,7" TextWrapping="Wrap"/>
                        <Button Content="EJECUTAR RED LOCAL" Click="Subnet_Click" Height="30" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
                <Border Padding="10" Margin="0,0,0,8" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="RED COMPLETA" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Recorre las subredes de todas las interfaces IPv4 activas elegibles. Es el perfil de mayor alcance y puede tardar más." Margin="0,5,0,7" TextWrapping="Wrap"/>
                        <Button Content="EJECUTAR RED COMPLETA" Click="Full_Click" Height="30" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
                <Border Padding="10" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="INTERFAZ ACTUAL" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedInterface}" FontFamily="Consolas" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding StatusText}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="2" Content="CERRAR" Click="Close_Click" HorizontalAlignment="Right" Width="100" Height="30" Margin="0,10,0,0"/>
    </Grid>
</Window>