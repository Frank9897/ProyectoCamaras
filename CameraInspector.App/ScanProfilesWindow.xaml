<Window x:Class="CameraInspector.App.ScanProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Inspector — Perfiles de escaneo"
        Width="1080"
        Height="560"
        MinWidth="900"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">

    <Window.Resources>
        <Style x:Key="ProfileButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="ProfileCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="PERFILES DE ESCANEO"
                           FontFamily="Consolas"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="Elegí cuánto querés recorrer. La diferencia no es la IP del equipo: es el alcance del escaneo."
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="{StaticResource TextDimBrush}"
                           Margin="0,5,0,0"/>
            </StackPanel>
            <Border Grid.Column="1"
                    Background="{StaticResource Panel2Brush}"
                    BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="16,0,0,0">
                <StackPanel>
                    <TextBlock Text="INTERFAZ SELECCIONADA"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextDimBrush}"/>
                    <TextBlock Text="{Binding SelectedInterface}"
                               FontFamily="Consolas"
                               FontSize="11"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Los tres perfiles se muestran en una sola fila para que el alcance se compare de un vistazo. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 01 DIRECTA -->
            <Border Grid.Column="0" Style="{StaticResource ProfileCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Width="34" Height="34"
                                Background="{StaticResource Panel2Brush}"
                                BorderBrush="{StaticResource BorderBrush2}"
                                BorderThickness="1"
                                CornerRadius="6"
                                VerticalAlignment="Center">
                            <TextBlock Text="01" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DIRECTA" FontFamily="Consolas" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="UNA IP" FontSize="9" Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,16,0,16">
                        <TextBlock Text="Busca una sola dirección conocida."
                                   FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="Ideal para una cámara conectada directamente, una IP concreta o un equipo que querés comprobar sin barrer toda la red."
                                   Margin="0,8,0,14"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextDimBrush}"/>
                        <TextBlock Text="IP OBJETIVO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                        <TextBox Text="{Binding DirectCameraIp, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34"
                                 Margin="0,5,0,0"
                                 Padding="8,5"
                                 FontFamily="Consolas"/>
                    </StackPanel>

                    <Button Grid.Row="2" Content="ESCANEAR ESTA IP" Click="Direct_Click" Style="{StaticResource ProfileButton}"/>
                </Grid>
            </Border>

            <!-- 02 RED LOCAL -->
            <Border Grid.Column="2" Style="{StaticResource ProfileCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Width="34" Height="34"
                                Background="{StaticResource Panel2Brush}"
                                BorderBrush="{StaticResource BorderBrush2}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <TextBlock Text="02" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="RED LOCAL" FontFamily="Consolas" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="SUBRED DE LA INTERFAZ" FontSize="9" Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,16,0,16">
                        <TextBlock Text="Busca dentro de tu red local."
                                   FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="Usa la subred calculada desde la interfaz seleccionada. Ejemplo: PC 192.168.0.106/24 → red objetivo 192.168.0.0/24."
                                   Margin="0,8,0,14"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextDimBrush}"/>
                        <Border Background="{StaticResource Panel2Brush}"
                                BorderBrush="{StaticResource BorderBrush2}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="10">
                            <StackPanel>
                                <TextBlock Text="IP DEL PC ≠ RED A ESCANEAR"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="La IP identifica a tu PC. La máscara permite calcular qué direcciones pertenecen a la subred."
                                           FontSize="10"
                                           Foreground="{StaticResource TextDimBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Button Grid.Row="2" Content="ESCANEAR RED LOCAL" Click="Subnet_Click" Style="{StaticResource ProfileButton}"/>
                </Grid>
            </Border>

            <!-- 03 RED COMPLETA -->
            <Border Grid.Column="4" Style="{StaticResource ProfileCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Width="34" Height="34"
                                Background="{StaticResource Panel2Brush}"
                                BorderBrush="{StaticResource BorderBrush2}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <TextBlock Text="03" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="RED COMPLETA" FontFamily="Consolas" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="TODAS LAS INTERFACES" FontSize="9" Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,16,0,16">
                        <TextBlock Text="Amplía la búsqueda a todo el equipo."
                                   FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="Recorre las subredes IPv4 activas y elegibles de todas las interfaces. Sirve cuando no sabés por cuál adaptador está conectada la cámara."
                                   Margin="0,8,0,14"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextDimBrush}"/>
                        <Border Background="{StaticResource Panel2Brush}"
                                BorderBrush="{StaticResource BorderBrush2}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="10">
                            <StackPanel>
                                <TextBlock Text="MAYOR ALCANCE"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="Puede tardar más porque puede analizar más de una red física o virtual."
                                           FontSize="10"
                                           Foreground="{StaticResource TextDimBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Button Grid.Row="2" Content="ESCANEAR RED COMPLETA" Click="Full_Click" Style="{StaticResource ProfileButton}"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusText}"
                       VerticalAlignment="Center"
                       FontFamily="Consolas"
                       FontSize="10"
                       Foreground="{StaticResource TextDimBrush}"
                       TextWrapping="Wrap"/>
            <Button Content="CERRAR"
                    Click="Close_Click"
                    HorizontalAlignment="Right"
                    Width="110"
                    Height="34"
                    Style="{StaticResource ProfileButton}"/>
        </Grid>
    </Grid>
</Window>