<Window x:Class="CameraInspector.App.ScanProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Inspector — Alcance del escaneo"
        Width="1180"
        Height="570"
        MinWidth="1000"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">

    <Window.Resources>
        <Style x:Key="ProfileButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="ProfileCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="ALCANCE DEL ESCANEO"
                           FontFamily="Consolas"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="La interfaz de red indica POR DÓNDE sale el escaneo. El perfil indica CUÁNTO se busca. Son conceptos distintos."
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="{StaticResource TextDimBrush}"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource Panel2Brush}"
                BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource BgBrush}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,18,0" VerticalAlignment="Center">
                    <TextBlock Text="ADAPTADOR DE RED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                    <TextBlock Text="Seleccionado en la ventana principal" FontSize="10" FontFamily="Consolas"/>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="→" FontSize="18" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="3" Margin="18,0" VerticalAlignment="Center">
                    <TextBlock Text="ALCANCE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                    <TextBlock Text="Una IP · una subred · todas las subredes" FontSize="10" FontFamily="Consolas"/>
                </StackPanel>

                <TextBlock Grid.Column="4" Text="→" FontSize="18" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="5" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="RESULTADO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                    <TextBlock Text="Cámaras con evidencia suficiente" FontSize="10" FontFamily="Consolas"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Los tres perfiles se comparan en una sola fila. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ProfileCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Width="34" Height="34" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6">
                            <TextBlock Text="01" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DIRECTA" FontFamily="Consolas" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="UNA SOLA IP" FontSize="9" Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,14,0,14">
                        <TextBlock Text="Probá una dirección concreta."
                                   FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="No barre la red. Solo analiza la IP que ingreses. Es la opción más rápida cuando ya conocés la dirección de la cámara."
                                   Margin="0,7,0,12"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextDimBrush}"/>
                        <TextBlock Text="IP OBJETIVO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                        <TextBox Text="{Binding DirectCameraIp, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34" Margin="0,5,0,0" Padding="8,5" FontFamily="Consolas"/>
                    </StackPanel>
                    <Button Grid.Row="2" Content="ESCANEAR ESTA IP" Click="Direct_Click" Style="{StaticResource ProfileButton}"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource ProfileCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Width="34" Height="34" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6">
                            <TextBlock Text="02" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="RED LOCAL" FontFamily="Consolas" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="SUBRED DEL ADAPTADOR" FontSize="9" Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,14,0,14">
                        <TextBlock Text="Busca en la red del adaptador elegido."
                                   FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="Si el PC está en 192.168.0.106/24, la red es 192.168.0.0/24. El adaptador determina esa subred y por dónde se envían las pruebas."
                                   Margin="0,7,0,12"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextDimBrush}"/>
                        <Border Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="5" Padding="9">
                            <StackPanel>
                                <TextBlock Text="NO ES OTRA INTERFAZ"
                                           FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="Es la misma interfaz seleccionada en la ventana principal; aquí solo se explica qué rango se escaneará."
                                           FontSize="10" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Button Grid.Row="2" Content="ESCANEAR RED LOCAL" Click="Subnet_Click" Style="{StaticResource ProfileButton}"/>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource ProfileCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Width="34" Height="34" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6">
                            <TextBlock Text="03" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="RED COMPLETA" FontFamily="Consolas" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="TODOS LOS ADAPTADORES" FontSize="9" Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,14,0,14">
                        <TextBlock Text="Busca en todas las redes activas."
                                   FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="Recorre las subredes IPv4 elegibles de todas las interfaces activas. Útil si tenés Ethernet, Wi-Fi o redes virtuales y no sabés dónde está la cámara."
                                   Margin="0,7,0,12"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextDimBrush}"/>
                        <Border Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="5" Padding="9">
                            <StackPanel>
                                <TextBlock Text="MAYOR ALCANCE = MAYOR TIEMPO"
                                           FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="Puede analizar más de una red física o virtual."
                                           FontSize="10" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Button Grid.Row="2" Content="ESCANEAR RED COMPLETA" Click="Full_Click" Style="{StaticResource ProfileButton}"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="ADAPTADOR ACTUAL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                <TextBlock Text="{Binding SelectedInterface}" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"/>
                <TextBlock Text="El selector del adaptador está en la ventana principal. Este dato solo informa desde dónde se hará el escaneo."
                           FontSize="9" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" MaxWidth="420" Margin="0,0,14,0"/>
                <Button Content="CERRAR" Click="Close_Click" Width="110" Height="34" Style="{StaticResource ProfileButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
