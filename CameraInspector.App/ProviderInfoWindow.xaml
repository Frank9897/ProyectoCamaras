<Window x:Class="CameraInspector.App.ProviderInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Inspector — Información propietaria"
        Width="620"
        Height="520"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#040705"
        Foreground="#A9DEB6">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="INFORMACIÓN PROPIETARIA"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#00E676" />

        <StackPanel Grid.Row="1" Margin="0,14,0,12">
            <TextBlock Text="Provider detectado"
                       Foreground="#638B6D"
                       FontSize="12" />
            <TextBlock Text="{Binding ProviderName}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,3,0,0" />
        </StackPanel>

        <Border Grid.Row="2"
                Background="#08100B"
                BorderBrush="#163A24"
                BorderThickness="1"
                Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Fabricante" Foreground="#638B6D" Margin="0,0,0,10" />
                    <TextBlock Grid.Column="1" Text="{Binding ProviderInfo.Manufacturer, TargetNullValue=—}" Margin="0,0,0,10" />

                    <TextBlock Grid.Row="1" Text="Modelo" Foreground="#638B6D" Margin="0,0,0,10" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProviderInfo.Model, TargetNullValue=—}" Margin="0,0,0,10" />

                    <TextBlock Grid.Row="2" Text="Firmware" Foreground="#638B6D" Margin="0,0,0,10" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProviderInfo.FirmwareVersion, TargetNullValue=—}" Margin="0,0,0,10" />

                    <TextBlock Grid.Row="3" Text="Serial" Foreground="#638B6D" Margin="0,0,0,10" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProviderInfo.SerialNumber, TargetNullValue=—}" Margin="0,0,0,10" />

                    <TextBlock Grid.Row="4" Text="MAC" Foreground="#638B6D" Margin="0,0,0,10" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ProviderInfo.MacAddress, TargetNullValue=—}" Margin="0,0,0,10" />

                    <TextBlock Grid.Row="5" Text="Tipo de dispositivo" Foreground="#638B6D" Margin="0,0,0,10" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ProviderInfo.DeviceType, TargetNullValue=—}" Margin="0,0,0,10" />

                    <TextBlock Grid.Row="6"
                               Grid.ColumnSpan="2"
                               Text="{Binding StatusText}"
                               Foreground="#00E676"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0" />
                </Grid>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="ACTUALIZAR"
                    Command="{Binding LoadCommand}"
                    Margin="0,0,10,0"
                    Padding="18,8" />
            <Button Content="CERRAR"
                    Command="{Binding CloseCommand}"
                    Padding="18,8" />
        </StackPanel>
    </Grid>
</Window>
