<Window x:Class="CameraInspector.App.ProviderInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:responsive="clr-namespace:CameraInspector.App.Responsive"
        responsive:ResponsiveWindowBehavior.Enable="True"
        Title="Camera Inspector — Información propietaria"
        Width="620"
        Height="520"
        MinWidth="420"
        MinHeight="360"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="180" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="14" CornerRadius="5">
            <TextBlock Text="INFORMACIÓN PROPIETARIA" FontFamily="Consolas" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="1" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="12" Margin="0,10,0,10">
            <StackPanel>
                <TextBlock Text="PROVEEDOR DETECTADO" Foreground="{StaticResource TextDimBrush}" FontFamily="Consolas" FontSize="10" FontWeight="Bold" />
                <TextBlock Text="{Binding ProviderName, TargetNullValue=—}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="5" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="135" /><ColumnDefinition Width="*" MinWidth="120" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Fabricante" Foreground="{StaticResource TextDimBrush}" Margin="0,0,8,10" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1" Text="{Binding ProviderInfo.Manufacturer, TargetNullValue=—}" Margin="0,0,0,10" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="Modelo" Foreground="{StaticResource TextDimBrush}" Margin="0,0,8,10" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProviderInfo.Model, TargetNullValue=—}" Margin="0,0,0,10" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Text="Firmware" Foreground="{StaticResource TextDimBrush}" Margin="0,0,8,10" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProviderInfo.FirmwareVersion, TargetNullValue=—}" Margin="0,0,0,10" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" Text="Serial" Foreground="{StaticResource TextDimBrush}" Margin="0,0,8,10" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProviderInfo.SerialNumber, TargetNullValue=—}" Margin="0,0,0,10" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="4" Text="MAC" Foreground="{StaticResource TextDimBrush}" Margin="0,0,8,10" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ProviderInfo.MacAddress, TargetNullValue=—}" Margin="0,0,0,10" TextWrapping="Wrap" FontFamily="Consolas" />
                    <TextBlock Grid.Row="5" Text="Tipo de dispositivo" Foreground="{StaticResource TextDimBrush}" Margin="0,0,8,10" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ProviderInfo.DeviceType, TargetNullValue=—}" Margin="0,0,0,10" TextWrapping="Wrap" />
                    <Border Grid.Row="6" Grid.ColumnSpan="2" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="10" Margin="0,4,0,0">
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>

        <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="ACTUALIZAR" Command="{Binding LoadCommand}" MinWidth="110" Height="34" Margin="0,0,8,5" Style="{StaticResource SecondaryButton}" />
            <Button Content="CERRAR" Command="{Binding CloseCommand}" MinWidth="90" Height="34" Margin="0,0,0,5" Style="{StaticResource PrimaryButton}" />
        </WrapPanel>
    </Grid>
</Window>
