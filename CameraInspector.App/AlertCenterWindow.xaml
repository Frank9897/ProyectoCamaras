<Window x:Class="CameraInspector.App.AlertCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Inspector — Centro de alertas"
        Width="1050"
        Height="620"
        MinWidth="760"
        MinHeight="420"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="CENTRO DE ALERTAS" FontFamily="Consolas" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="Cambios históricos, conflictos de IP y fallos de diagnóstico registrados en SQLite." FontSize="10" Foreground="{StaticResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
            <Button Grid.Column="1" Content="ACTUALIZAR" Width="110" Height="30" Click="RefreshButton_Click"/>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="5">
            <DataGrid x:Name="AlertsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserResizeRows="False"
                      RowHeight="28"
                      ColumnHeaderHeight="29"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SEVERIDAD" Binding="{Binding Severity}" Width="90"/>
                    <DataGridTextColumn Header="TIPO" Binding="{Binding Type}" Width="135"/>
                    <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="120"/>
                    <DataGridTextColumn Header="FABRICANTE" Binding="{Binding Manufacturer}" Width="120"/>
                    <DataGridTextColumn Header="MODELO" Binding="{Binding Model}" Width="130"/>
                    <DataGridTextColumn Header="DETALLE" Binding="{Binding Description}" Width="*" MinWidth="280"/>
                    <DataGridTextColumn Header="FECHA" Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="155"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="Las alertas son registros históricos. Un nuevo escaneo o diagnóstico puede generar nuevos eventos cuando detecta una condición diferente."
                   FontSize="9"
                   Foreground="{StaticResource TextDimBrush}"
                   Margin="2,8,2,0"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
