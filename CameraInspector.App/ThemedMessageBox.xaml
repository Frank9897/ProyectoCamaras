<Window x:Class="CameraInspector.App.ThemedMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        MinWidth="360"
        MaxWidth="560"
        Background="{StaticResource PanelBrush}">
    <Border Padding="22,20,22,16" Background="{StaticResource PanelBrush}">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="IconBadge"
                        Grid.Column="0"
                        Width="40" Height="40"
                        CornerRadius="20"
                        Margin="0,0,16,0"
                        VerticalAlignment="Top"
                        Background="{StaticResource Panel2Brush}"
                        BorderThickness="2">
                    <TextBlock x:Name="IconGlyph"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Consolas"
                               FontWeight="Bold"
                               FontSize="18"/>
                </Border>

                <TextBlock x:Name="MessageTextBlock"
                           Grid.Column="1"
                           TextWrapping="Wrap"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center"/>
            </Grid>

            <StackPanel x:Name="ButtonsPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"/>
        </StackPanel>
    </Border>
</Window>
