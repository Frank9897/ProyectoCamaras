<Window x:Class="CameraInspector.App.NetworkConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Inspector — Configuración de cámara IP"
        Width="1080"
        Height="780"
        MinWidth="760"
        MinHeight="560"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="260" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel MinWidth="260">
                <TextBlock Text="CONFIGURACIÓN DE CÁMARA IP" FontFamily="Consolas" FontSize="19" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Text="Administración de red, identificación y sistema. Primero lea el estado actual; luego valide y confirme cada cambio."/>
            </StackPanel>
            <Border Grid.Column="1" Padding="10,7" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Background="{StaticResource Panel2Brush}" CornerRadius="4" VerticalAlignment="Center" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="CÁMARA SELECCIONADA" Foreground="{StaticResource TextDimBrush}" FontSize="9" FontWeight="Bold"/>
                    <TextBlock Text="{Binding CameraIpAddress}" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="{Binding CameraManufacturer}" FontFamily="Consolas" Foreground="{StaticResource TextDimBrush}" FontSize="9" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Margin="0,10,0,8" Padding="10" Background="{StaticResource Panel3Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel MinWidth="220">
                    <TextBlock Text="ESTADO DE CONFIGURACIÓN" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsStatusError}" Value="True"><Setter Property="Foreground" Value="{StaticResource ErrBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ValidationMessage}" Margin="0,4,0,0" Foreground="{StaticResource WarnBrush}" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"/>
                    <TextBlock Text="● CAMBIOS PENDIENTES" Margin="0,5,0,0" Foreground="{StaticResource WarnBrush}" FontFamily="Consolas" FontSize="10" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0">
                    <Button Content="↻ LEER ACTUAL" Command="{Binding LoadCommand}" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="0,0,7,5" ToolTip="Consulta nuevamente la cámara. No modifica nada."/>
                    <Button Content="CERRAR" Command="{Binding CloseCommand}" Padding="14,8" Margin="0,0,0,5" ToolTip="Cierra sin aplicar cambios pendientes."/>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="9" Margin="0,0,0,8" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextDimBrush}"><Run Text="FLUJO RECOMENDADO: " FontWeight="Bold" Foreground="{StaticResource TextBrush}"/><Run Text="LEER ACTUAL → seleccionar interfaz → editar → VALIDAR → APLICAR. "/><Run Text="Los cambios de IP pueden cortar la conexión." Foreground="{StaticResource WarnBrush}"/></TextBlock>
        </Border>

        <TabControl Grid.Row="3">
            <TabItem Header="RESUMEN">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="160"/></Grid.RowDefinitions>
                    <TextBlock Text="INTERFACES DE RED DETECTADAS" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                    <DataGrid Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="INTERFAZ" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="TOKEN" Binding="{Binding Token}" Width="170"/>
                            <DataGridTextColumn Header="MAC" Binding="{Binding HwAddress}" Width="155"/>
                            <DataGridTextColumn Header="IPv4" Binding="{Binding IPv4Address}" Width="145"/>
                            <DataGridTextColumn Header="CIDR" Binding="{Binding IPv4PrefixLength}" Width="70"/>
                            <DataGridTextColumn Header="DHCP" Binding="{Binding IPv4Dhcp}" Width="75"/>
                            <DataGridTextColumn Header="MTU" Binding="{Binding Mtu}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="RED IPv4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="CONFIGURACIÓN DE RED IPv4" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,12" Text="Configure DHCP o una dirección estática. Los datos se validan localmente antes de enviar la operación." Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="2" Text="INTERFAZ" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedInterface.Name}" FontFamily="Consolas" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="3" Text="MODO IPv4" Margin="0,12,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                        <CheckBox Grid.Row="3" Grid.Column="1" Content="Usar DHCP automáticamente" IsChecked="{Binding UseDhcp}" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="4" Text="DIRECCIÓN IPv4" Margin="0,12,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Ipv4Address, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="5" Text="PREFIJO CIDR" Margin="0,10,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                        <WrapPanel Grid.Row="5" Grid.Column="1" Margin="0,8,0,0">
                            <TextBox Text="{Binding PrefixLength, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Width="90" Margin="0,0,10,5"/>
                            <TextBlock Text="ejemplo: 24 = 255.255.255.0" Margin="0,7,0,5" Foreground="{StaticResource TextDimBrush}" FontSize="10" TextWrapping="Wrap"/>
                        </WrapPanel>
                        <TextBlock Grid.Row="6" Text="GATEWAY IPv4" Margin="0,12,0,0" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding GatewayAddress, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Margin="0,8,0,0"/>
                        <WrapPanel Grid.Row="7" Grid.ColumnSpan="2" Margin="0,18,0,0">
                            <Button Content="✓ VALIDAR CONFIGURACIÓN" Command="{Binding ValidateNetworkCommand}" Style="{StaticResource SecondaryButton}" Padding="16,9" Margin="0,0,8,5"/>
                            <Button Content="APLICAR CAMBIOS" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" Padding="18,9" Margin="0,0,0,5"/>
                        </WrapPanel>
                        <Border Grid.Row="8" Grid.ColumnSpan="2" Margin="0,14,0,0" Padding="12" Background="{StaticResource Panel3Brush}" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1"><TextBlock TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}"><Run Text="IMPORTANTE: " FontWeight="Bold"/><Run Text="si cambia la IP, la cámara puede desaparecer de la dirección actual. Anote la nueva IP antes de aplicar."/></TextBlock></Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="NOMBRE">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="16">
                        <StackPanel MaxWidth="780">
                            <TextBlock Text="IDENTIFICACIÓN DE LA CÁMARA" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,6,0,14" Text="El nombre ONVIF ayuda a reconocer la cámara. No modifica la dirección IP." Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="NOMBRE ACTUAL / NUEVO" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                            <TextBox Text="{Binding Hostname, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="16" Margin="0,7,0,0"/>
                            <TextBlock Text="Permitido: letras, números y guiones · 1 a 63 caracteres · sin espacios." Margin="0,6,0,0" Foreground="{StaticResource TextDimBrush}" FontSize="10" TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,16,0,0">
                                <Button Content="↻ LEER NOMBRE" Command="{Binding LoadHostnameCommand}" Style="{StaticResource SecondaryButton}" Padding="16,8" Margin="0,0,8,5"/>
                                <Button Content="GUARDAR NOMBRE" Command="{Binding SetHostnameCommand}" Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="0,0,0,5"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="SERVICIOS">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="160"/></Grid.RowDefinitions>
                    <TextBlock Text="PROTOCOLOS ANUNCIADOS POR LA CÁMARA" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                    <DataGrid Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding Protocols}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SERVICIO / PROTOCOLO" Binding="{Binding Name}" Width="220"/>
                            <DataGridTextColumn Header="ESTADO" Binding="{Binding Enabled}" Width="130"/>
                            <DataGridTextColumn Header="PUERTOS" Binding="{Binding Ports}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="GATEWAY">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="16">
                        <StackPanel>
                            <TextBlock Text="GATEWAY IPv4 DETECTADO" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,6,0,14" Text="Este apartado muestra lo que la cámara informa actualmente. Para modificarlo use RED IPv4." Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding Gateways}">
                                <ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,0,7" Padding="12" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"><TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="14" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Si no aparece ningún valor, la cámara no informó un gateway." Margin="0,8,0,0" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="SISTEMA">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16" MaxWidth="820">
                        <TextBlock Text="ACCIONES DEL SISTEMA" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                        <Border Margin="0,12,0,10" Padding="12" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="REINICIAR" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Margin="0,5,0,0" Text="Reinicia la cámara sin restablecer su configuración. Puede perderse la conexión durante unos segundos." Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
                                <Button Content="↻ REINICIAR CÁMARA" Command="{Binding RebootCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="16,8" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Padding="12" Background="{StaticResource Panel3Brush}" BorderBrush="{StaticResource ErrBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="ZONA DE PELIGRO" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource ErrBrush}"/>
                                <TextBlock Margin="0,5,0,0" Text="RESTABLECIMIENTO DE FÁBRICA puede borrar red, usuarios y otros ajustes. La cámara puede quedar con otra IP o requerir configuración inicial." Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                                <Button Content="⚠ RESTABLECER DE FÁBRICA" Command="{Binding FactoryResetCommand}" Style="{StaticResource SecondaryButton}" Foreground="{StaticResource ErrBrush}" HorizontalAlignment="Left" Padding="16,8" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Left" Text="{Binding ValidationMessage}" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560" Margin="0,0,10,5"/>
            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock Text="● cambios pendientes" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center" Margin="0,0,12,5">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <Button Content="↻ ACTUALIZAR DATOS" Command="{Binding LoadCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,5}"/>
                <Button Content="CERRAR" Command="{Binding CloseCommand}" Margin="0,0,0,5"/>
            </WrapPanel>
        </DockPanel>
    </Grid>
</Window>
