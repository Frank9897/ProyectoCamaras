<Window x:Class="CameraInspector.App.NetworkConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Inspector — Configuración de red"
        Width="1040"
        Height="760"
        MinWidth="860"
        MinHeight="640"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14" Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="CONFIGURACIÓN DE RED / CÁMARA"
                   FontFamily="Consolas"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="{StaticResource AccentBrush}" />

        <TextBlock Grid.Row="1"
                   Margin="0,6,0,12"
                   Text="Administración ONVIF · IPv4 · gateway · nombre · reinicio · restablecimiento de fábrica"
                   Foreground="{StaticResource TextDimBrush}" />

        <TabControl Grid.Row="2">
            <TabItem Header="INTERFACES">
                <Grid Margin="8">
                    <DataGrid ItemsSource="{Binding Interfaces}"
                              SelectedItem="{Binding SelectedInterface, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TOKEN" Binding="{Binding Token}" Width="140" />
                            <DataGridTextColumn Header="NOMBRE" Binding="{Binding Name}" Width="120" />
                            <DataGridTextColumn Header="MAC" Binding="{Binding HwAddress}" Width="150" />
                            <DataGridTextColumn Header="IP" Binding="{Binding IPv4Address}" Width="150" />
                            <DataGridTextColumn Header="PREFIJO" Binding="{Binding IPv4PrefixLength}" Width="80" />
                            <DataGridTextColumn Header="DHCP" Binding="{Binding IPv4Dhcp}" Width="80" />
                            <DataGridTextColumn Header="MTU" Binding="{Binding Mtu}" Width="80" />
                            <DataGridTextColumn Header="ACTIVA" Binding="{Binding Enabled}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="RED IPv4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock Text="INTERFAZ SELECCIONADA"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontFamily="Consolas"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding SelectedInterface.Token}"
                                   FontFamily="Consolas"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="0,0,0,14" />

                        <CheckBox Content="OBTENER IPv4 POR DHCP"
                                  IsChecked="{Binding UseDhcp}"
                                  Margin="0,0,0,14" />

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="IPv4" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding IPv4Address, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas" />

                            <TextBlock Grid.Row="1" Text="Prefijo CIDR" VerticalAlignment="Center" Margin="0,10,0,0" Foreground="{StaticResource TextDimBrush}" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding PrefixLength, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas"
                                     Margin="0,10,0,0" />
                        </Grid>

                        <TextBlock Text="Gateway IPv4" Margin="0,18,0,6" Foreground="{StaticResource TextDimBrush}" />
                        <TextBox Text="{Binding GatewayAddress, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />

                        <Border Margin="0,18,0,0"
                                Padding="12"
                                Background="{StaticResource Panel2Brush}"
                                BorderBrush="{StaticResource BorderBrush2}"
                                BorderThickness="1">
                            <TextBlock TextWrapping="Wrap"
                                       Text="ADVERTENCIA: cambiar la IP puede cortar la conexión con la cámara. Se solicitará confirmación antes de aplicar los cambios."
                                       Foreground="{StaticResource WarnBrush}" />
                        </Border>

                        <Button Content="APLICAR CAMBIOS DE RED"
                                Command="{Binding ApplyCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left"
                                Margin="0,18,0,0"
                                Padding="18,9" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="NOMBRE">
                <Grid Margin="18">
                    <StackPanel MaxWidth="760">
                        <TextBlock Text="NOMBRE DE LA CÁMARA"
                                   FontFamily="Consolas"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Nombre de host ONVIF. Use letras, números y guiones."
                                   Margin="0,6,0,12"
                                   Foreground="{StaticResource TextDimBrush}" />
                        <TextBox Text="{Binding Hostname, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas"
                                 FontSize="16"
                                 Height="36" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="LEER NOMBRE"
                                    Command="{Binding LoadHostnameCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="16,8"
                                    Margin="0,0,8,0" />
                            <Button Content="GUARDAR NOMBRE"
                                    Command="{Binding SetHostnameCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="16,8" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="PROTOCOLOS">
                <Grid Margin="8">
                    <DataGrid ItemsSource="{Binding Protocols}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PROTOCOLO" Binding="{Binding Name}" Width="180" />
                            <DataGridTextColumn Header="HABILITADO" Binding="{Binding Enabled}" Width="140" />
                            <DataGridTextColumn Header="PUERTOS" Binding="{Binding Ports}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="SISTEMA">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock Text="ACCIONES DEL SISTEMA"
                                   FontFamily="Consolas"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" />

                        <Border Margin="0,12,0,0"
                                Padding="12"
                                Background="{StaticResource Panel2Brush}"
                                BorderBrush="{StaticResource BorderBrush2}"
                                BorderThickness="1">
                            <TextBlock TextWrapping="Wrap"
                                       Text="REINICIAR: reinicia solamente el dispositivo. Los cambios de red que requieran reinicio se activarán después del arranque."
                                       Foreground="{StaticResource TextBrush}" />
                        </Border>
                        <Button Content="REINICIAR CÁMARA"
                                Command="{Binding RebootCommand}"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,18"
                                Padding="18,9" />

                        <Border Padding="12"
                                Background="{StaticResource Panel2Brush}"
                                BorderBrush="{StaticResource ErrBrush}"
                                BorderThickness="1">
                            <TextBlock TextWrapping="Wrap"
                                       Text="RESTABLECIMIENTO DE FÁBRICA: acción destructiva. Puede borrar configuración de red, usuarios y demás parámetros. Requiere doble confirmación."
                                       Foreground="{StaticResource ErrBrush}" />
                        </Border>
                        <Button Content="⚠ RESTABLECER DE FÁBRICA"
                                Command="{Binding FactoryResetCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Foreground="{StaticResource ErrBrush}"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0"
                                Padding="18,9" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="GATEWAY">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Gateway IPv4 detectados" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Gateways}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="10" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{StaticResource TextDimBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="ACTUALIZAR"
                        Command="{Binding LoadCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0" />
                <Button Content="CERRAR" Command="{Binding CloseCommand}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
