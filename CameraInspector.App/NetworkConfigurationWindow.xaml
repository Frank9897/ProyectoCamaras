<Window x:Class="CameraInspector.App.NetworkConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Inspector — Configuración de red"
        Width="980"
        Height="720"
        MinWidth="820"
        MinHeight="600"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="CONFIGURACIÓN DE RED"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="{StaticResource AccentBrush}" />

        <TextBlock Grid.Row="1"
                   Margin="0,6,0,12"
                   Text="Consulta ONVIF + edición controlada · los cambios de IPv4/gateway requieren confirmación."
                   Foreground="{StaticResource TextDimBrush}" />

        <TabControl Grid.Row="2">
            <TabItem Header="INTERFACES">
                <Grid Margin="8">
                    <DataGrid ItemsSource="{Binding Interfaces}"
                              SelectedItem="{Binding SelectedInterface, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TOKEN" Binding="{Binding Token}" Width="140" />
                            <DataGridTextColumn Header="NOMBRE" Binding="{Binding Name}" Width="120" />
                            <DataGridTextColumn Header="MAC" Binding="{Binding HwAddress}" Width="150" />
                            <DataGridTextColumn Header="IP" Binding="{Binding IPv4Address}" Width="150" />
                            <DataGridTextColumn Header="PREFIJO" Binding="{Binding IPv4PrefixLength}" Width="80" />
                            <DataGridTextColumn Header="DHCP" Binding="{Binding IPv4Dhcp}" Width="80" />
                            <DataGridTextColumn Header="MTU" Binding="{Binding Mtu}" Width="80" />
                            <DataGridTextColumn Header="ACTIVA" Binding="{Binding Enabled}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="EDITAR IPV4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock Text="INTERFAZ SELECCIONADA"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding SelectedInterface.Token}"
                                   FontFamily="Consolas"
                                   Margin="0,0,0,14" />

                        <CheckBox Content="OBTENER IPv4 POR DHCP"
                                  IsChecked="{Binding UseDhcp}"
                                  Margin="0,0,0,14" />

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="IPv4" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding IPv4Address, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas" />

                            <TextBlock Grid.Row="1" Text="Prefijo CIDR" VerticalAlignment="Center" Margin="0,10,0,0" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding PrefixLength, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas"
                                     Margin="0,10,0,0" />
                        </Grid>

                        <TextBlock Text="Gateway IPv4"
                                   Margin="0,18,0,6" />
                        <TextBox Text="{Binding GatewayAddress, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" />

                        <Border Margin="0,18,0,0"
                                Padding="12"
                                Background="{StaticResource Panel2Brush}"
                                BorderBrush="{StaticResource BorderBrush2}"
                                BorderThickness="1">
                            <TextBlock TextWrapping="Wrap"
                                       Text="ADVERTENCIA: cambiar la IP puede cortar la conexión con la cámara. La aplicación pedirá confirmación antes de enviar el cambio y mostrará si ONVIF indicó que hace falta reiniciar."
                                       Foreground="{StaticResource TextBrush}" />
                        </Border>

                        <Button Content="APLICAR CAMBIOS DE RED"
                                Command="{Binding ApplyCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left"
                                Margin="0,18,0,0"
                                Padding="18,9" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="PROTOCOLOS">
                <Grid Margin="8">
                    <DataGrid ItemsSource="{Binding Protocols}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PROTOCOLO" Binding="{Binding Name}" Width="180" />
                            <DataGridTextColumn Header="HABILITADO" Binding="{Binding Enabled}" Width="140" />
                            <DataGridTextColumn Header="PUERTOS" Binding="{Binding Ports}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="GATEWAY">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Gateway IPv4 detectados"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Gateways}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6"
                                            Padding="10"
                                            Background="{StaticResource Panel2Brush}"
                                            BorderBrush="{StaticResource BorderBrush2}"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding}"
                                                   FontFamily="Consolas" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{StaticResource TextDimBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="ACTUALIZAR"
                        Command="{Binding LoadCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0" />
                <Button Content="CERRAR"
                        Command="{Binding CloseCommand}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
